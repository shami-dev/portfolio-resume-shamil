---
// Footer content varies per page (plain labels on Home/About, prev/next
// case links on case-detail, colophon links elsewhere) and mixes text
// with real <a> elements — same rationale as Rail: pages compose their
// own left/right content into this shared .ft chrome rather than a
// rigid text/href prop API.
//
// ModeSwitch lives here rather than in the rail (where the 5D dark-mode
// doc places it) so that one instance serves both layouts. The mobile
// header has no room for it without pushing the scan below the fold, and
// relocating a single node across the rail/column boundary is not
// something CSS can do without breaking focus order. Rendering it in the
// footer keeps DOM order and visual order agreed at every width, and
// puts it with the rest of the set-once chrome. The rail is not sticky,
// so this costs less on desktop than it looks: the control was never
// persistently visible there either.
//
// It sits between the left/right slots (not below them): .ft's existing
// justify-content: space-between already spaces three children, so no
// extra positioning rule was needed to seat it between the two lines.
import type { HTMLAttributes } from "astro/types";
import ModeSwitch from "./ModeSwitch.astro";

type Props = HTMLAttributes<"div">;

const rest = Astro.props as Props;
---

<div class="ft" {...rest}>
  <slot name="left" />
  <ModeSwitch />
  <slot name="right" />
</div>
