---
// Mounted photographic plate — the "supplied" state of Placeholder.astro's
// "reserved" box. Same CLS-0 job, different state: a solid hairline instead
// of the dashed one (dashed reads as not-yet-delivered), a paper mat between
// rule and image, and drafting corner brackets in place of the mono
// slug/kind labels. See §"Photographic plate" in global.css.
//
// Ratio is set by a class on the mount, never by an inline style: the hero
// ratio changes at the mobile breakpoint, and an inline style wins over any
// stylesheet rule regardless of specificity, so the mobile value would have
// nowhere to attach — same reasoning as .hero-fig's own comment.
import type { HTMLAttributes } from "astro/types";
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props extends HTMLAttributes<"figure"> {
  /** Local import from src/assets — a path string skips optimization. */
  src: ImageMetadata;
  /** Mandatory on <Picture>; "" is valid only for a decorative plate. */
  alt: string;
  /** Plate number, e.g. "FIG. 01". Omitted renders no figcaption. */
  fig?: string;
  /** Reserved ratio — maps to .plate-mount-<ratio> in global.css. */
  ratio?: "hero" | "evidence" | "portrait";
  /** Above-the-fold plates (the case hero): eager, high fetchpriority. */
  priority?: boolean;
  /**
   * Rendered width per viewport, for srcset selection. The default assumes
   * a full content column (~1000px inside the 1400px sheet, less the 300px
   * rail and 56px gutters). Paired evidence figures share that column, so
   * they should pass roughly half.
   */
  sizes?: string;
}

const {
  src,
  alt,
  fig,
  ratio = "evidence",
  priority = false,
  sizes = "(min-width: 48rem) 1000px, 100vw",
  class: className,
  ...rest
} = Astro.props;
---

<figure class={["plate", className].filter(Boolean).join(" ")} {...rest}>
  <div class={`plate-mount plate-mount-${ratio}`}>
    {
      /* formats order is the <source> order the browser walks, so most
        modern first. fallbackFormat is left at its default — it already
        follows the source (.jpg for a JPG original). Attributes set here
        land on the inner <img>, which is what .plate-img styles. */
    }
    <Picture
      class="plate-img"
      src={src}
      alt={alt}
      formats={["avif", "webp"]}
      layout="full-width"
      sizes={sizes}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
    />
  </div>
  {fig && <figcaption class="plate-fig">{fig}</figcaption>}
</figure>
