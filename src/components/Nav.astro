---
// Phase 7: "Build notes already commit to semantic <a>/<button>/<nav>
// (demo divs are demo-only)" — the mockup's <div class="nrow"> is a
// design-doc preview convention, not the intended real markup.
interface Props {
  /** Omit on footer-tier destinations (colophon, 404) that aren't in the
      primary nav — every item renders inactive. */
  current?: "home" | "work" | "about" | "contact";
}

const { current } = Astro.props as Props;

const items = [
  { key: "home", label: "HOME", href: "/" },
  { key: "work", label: "WORK", href: "/work" },
  { key: "about", label: "ABOUT", href: "/about" },
  { key: "contact", label: "CONTACT", href: "/contact" },
] as const;
---

<nav class="nav">
  {
    items.map((item) => {
      const isActive = item.key === current;
      return (
        <a
          href={item.href}
          class={isActive ? "nrow-a" : "nrow"}
          aria-current={isActive ? "page" : undefined}
        >
          {item.label}
        </a>
      );
    })
  }
</nav>
