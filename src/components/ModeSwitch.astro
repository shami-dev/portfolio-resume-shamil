---
// Mode control (Phase 5a·v2 dark-mode doc, "MODE CONTROL — SITE CHROME"):
// segmented, three real states — not a binary switch. Sharp corners
// (hard-control register). Renders inside Footer, not the rail — see
// Footer.astro for why a single shared instance lives there instead.
//
// Native radios rather than role="radio" buttons: three mutually exclusive
// states is exactly a radiogroup, and the browser gives arrow-key roving
// focus for free instead of us hand-rolling it.
//
// No option is marked checked in the markup: pages are prerendered, so any
// hardcoded default would render wrong for anyone whose mode differs. The
// script below checks the live one once it runs.
//
// mode-switch-label duplicates the legend's text, visually, for the
// mobile pre-footer placement (Phase 5b 6.0 §4) — <legend> renders as a
// special box that straddles the fieldset's own top border by design
// (confirmed via getBoundingClientRect: legend.top === fieldset.top),
// independent of the fieldset's display value, so un-hiding the real
// legend there cut a visible notch through the border instead of sitting
// above it. The legend itself stays permanently visually-hidden; this
// span is aria-hidden so the accessible name isn't announced twice.
const modes = [
  { value: "light", label: "LIGHT" },
  { value: "anoitecer", label: "ANOITECER" },
  { value: "dark", label: "DARK" },
] as const;
---

<span class="mode-switch-label" aria-hidden="true">THEME — SITE-WIDE</span>
<fieldset class="mode-switch">
  <legend class="visually-hidden">THEME — SITE-WIDE</legend>
  {
    modes.map((mode) => (
      <label class="mode-seg">
        <input
          class="visually-hidden"
          type="radio"
          name="mode"
          value={mode.value}
        />
        <span>{mode.label}</span>
      </label>
    ))
  }
</fieldset>

<script>
  const STORAGE_KEY = "mode";
  const root = document.documentElement;
  const inputs =
    document.querySelectorAll<HTMLInputElement>('input[name="mode"]');

  // Light is the bare :root token set, so it carries no data-theme.
  const current = root.dataset.theme ?? "light";
  for (const input of inputs) {
    input.checked = input.value === current;
    input.addEventListener("change", () => {
      if (input.value === "light") {
        delete root.dataset.theme;
      } else {
        root.dataset.theme = input.value;
      }
      try {
        localStorage.setItem(STORAGE_KEY, input.value);
      } catch {
        // Private mode / storage disabled: the mode still applies for
        // this page view, it just will not survive navigation.
      }
    });
  }
</script>
