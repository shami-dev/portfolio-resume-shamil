---
// 404 (Phase 5 §5.5) — MINIMAL, no grid, "one cell, one beat": a single
// centered card, no Rail/Nav chrome at all (this page intentionally
// breaks from every other page's rail+column layout). Static output
// (astro.config.mjs) prerenders this as 404.html, which Cloudflare Pages
// serves with a real 404 status for unmatched routes — noindex here
// plus the sitemap's own filter (astro.config.mjs) keep it out of
// search results (Phase 7 F-11). Verify the real 404 status against the
// actual Cloudflare deploy, not just astro dev/build.
import BaseLayout from "../layouts/BaseLayout.astro";
import TickRule from "../components/TickRule.astro";

const title = "Record not found";
const description =
  "noindex + real 404 status — the page you're looking for doesn't exist.";
---

<BaseLayout title={title} description={description} noindex>
  <div class="notfound">
    <div class="cell notfound-cell">
      <h1 class="notfound-label">RECORD NOT FOUND</h1>
      <p class="prose notfound-body">97%+ uptime — you found the other 3%.</p>
      <TickRule variant="light" style="margin: 20px 0" />
      <div class="notfound-actions">
        <a href="/" class="notfound-btn">HOME</a>
        <a href="/work" class="notfound-btn">WORK</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--col-pad);
  }

  /* Mock width "250px", padding "18px" x1.636 */
  .notfound-cell {
    max-width: 380px;
    padding: 30px;
  }

  /* Mock font-size 10px, color #7a2e2e. Sized as WCAG "large text"
     (>=18.66px + bold) rather than the mock's literal 10px-scaled
     size: --maroon can't clear 4.5:1 (normal-text threshold) against
     anoitecer/dark's warm-mid and near-black rail-chrome backgrounds
     without going washed-out pale — bumping to large text unlocks the
     3:1 threshold instead, verified via axe (see tokens.css). */
  .notfound-label {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.25rem; /* 20px */
    color: var(--maroon);
    letter-spacing: var(--ls-widest);
  }

  /* Mock margin-top "8px" x1.636 */
  .notfound-body {
    margin-top: 13px;
  }
  /* .cell is raised (--white) — anoitecer's plain --ink-body (.prose)
     measures 3.99:1 there, below AA (a11y gate finding). */
  :root[data-theme="anoitecer"] .notfound-body {
    color: var(--ink);
  }

  .notfound-actions {
    display: flex;
    gap: 13px; /* mock gap "8px" x1.636 */
  }

  /* Hard action (drafting register): sharp corners, instant hover swap —
     same register as About's RESUME.PDF button. Mock padding "5px 10px" x1.636 */
  .notfound-btn {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--fs-kicker); /* 15px, mock 9px */
    letter-spacing: var(--ls-wide);
    color: var(--ink);
    border: 1.5px solid var(--ink);
    padding: 8px 16px;
  }
  .notfound-btn:hover,
  .notfound-btn:focus-visible {
    background: var(--ink);
    color: var(--white);
  }

  /* Pressed state (Phase 5b 6.0 §3) — same ink fill as :hover, since
     hover has no mobile analog to avoid doubling up with. */
  @media (width < 48rem) {
    .notfound-btn {
      -webkit-tap-highlight-color: transparent;
    }
    .notfound-btn:active {
      background: var(--ink);
      color: var(--white);
    }
  }
</style>
