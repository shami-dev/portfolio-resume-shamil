---
// Contact (Phase 5 §5.5) — MINIMAL, no grid, form primary (KPI 2).
//
// Server-rendered on demand (`prerender = false`) so the `contact`
// action (src/actions/index.ts) can run as a real POST — works with
// JS disabled. Astro.getActionResult() renders the outcome server-side
// on load; the <script> below intercepts the same submit for
// JS-enabled clients so it doesn't reload the page. Visible <label>s
// per Phase 7 P0 fix #2 (placeholders alone fail contrast/vanish on
// input). Umami event tracking ("contact-form-submit" etc.) is still
// out of scope — no analytics script exists anywhere in the codebase
// yet; that's its own integration decision, not part of this page.
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import Rail from "../components/Rail.astro";
import Nav from "../components/Nav.astro";
import TickRule from "../components/TickRule.astro";
import Footer from "../components/Footer.astro";
import { actions, isInputError } from "astro:actions";

const title = "Contact — responds < 24h · Shamil Khaibullov";
const description =
  "Message, book 20 minutes, or email directly. Roles and contracts — remote or EU B2B, from Porto with an EU work permit.";

const result = Astro.getActionResult(actions.contact);
const inputErrors = isInputError(result?.error) ? result.error.fields : {};

// Shared with the <script> below: a send/rate-limit ActionError always
// carries a real message (src/actions/index.ts hardcodes both), but this
// still guards against any unexpected empty one — e.g. an edge-runtime
// failure with no message at all — rather than ever rendering a bare "✗".
const FALLBACK_ERROR =
  "Something went wrong — please email hello@shamil.dev directly.";

// "✗"/"✓" glyphs match the copy-button's existing success/failure
// convention below, so colour stays supplementary (WCAG 1.4.1) rather
// than load-bearing — --maroon fails AA at this text size in anoitecer
// (see the form-status[data-variant] rules), so the glyph carries the
// meaning.
let statusMessage = "";
let statusVariant: "success" | "error" | undefined;
if (result?.error) {
  statusVariant = "error";
  statusMessage = Object.keys(inputErrors).length
    ? "✗ Please fix the highlighted field(s) below."
    : `✗ ${result.error.message || FALLBACK_ERROR}`;
} else if (result) {
  statusVariant = "success";
  statusMessage = "✓ Message sent — I'll reply within 24h.";
}
---

<BaseLayout title={title} description={description} motion>
  <Rail>
    <div class="cell">
      <div class="clab">NAME</div>
      <div class="cell-name">Shamil Khaibullov</div>
    </div>
    <div class="cell-pair">
      <div class="cell">
        <div class="clab">LOC</div>
        <div class="cell-val-mono">Porto, PT</div>
      </div>
      <div class="cell">
        <div class="clab">AUTH</div>
        <div class="cell-val-mono">EU permit</div>
      </div>
    </div>
    <Nav current="contact" />
    <div class="rail-foot">
      <p class="contact-avail">
        AVAILABLE — ROLES + CONTRACTS<br />
        REMOTE / EU B2B<br />
        RESPONDS &lt; 24H
      </p>
    </div>
  </Rail>

  <div class="col contact">
    <h1 class="h1-case" data-register>Reach me.</h1>

    <div class="contact-row" data-register>
      <div class="cell contact-form-card">
        <div class="clab">MESSAGE — PRIMARY</div>
        <form
          class="contact-form"
          id="contact-form"
          method="POST"
          action={actions.contact}
        >
          <div class="field">
            <label for="name" class="clab field-label">Name</label>
            <input
              id="name"
              name="name"
              type="text"
              class="field-input"
              required
              aria-invalid={inputErrors.name ? "true" : undefined}
              aria-describedby={inputErrors.name ? "name-error" : undefined}
            />
            {
              inputErrors.name && (
                <p id="name-error" class="field-error" role="alert">
                  {inputErrors.name.join(" ")}
                </p>
              )
            }
          </div>
          <div class="field">
            <label for="email" class="clab field-label">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              class="field-input"
              required
              aria-invalid={inputErrors.email ? "true" : undefined}
              aria-describedby={inputErrors.email ? "email-error" : undefined}
            />
            {
              inputErrors.email && (
                <p id="email-error" class="field-error" role="alert">
                  {inputErrors.email.join(" ")}
                </p>
              )
            }
          </div>
          <div class="field">
            <label for="message" class="clab field-label">Message</label>
            <textarea
              id="message"
              name="message"
              class="field-input field-textarea"
              required
              aria-invalid={inputErrors.message ? "true" : undefined}
              aria-describedby={inputErrors.message
                ? "message-error"
                : undefined}></textarea>
            {
              inputErrors.message && (
                <p id="message-error" class="field-error" role="alert">
                  {inputErrors.message.join(" ")}
                </p>
              )
            }
          </div>
          <div class="field visually-hidden" aria-hidden="true">
            <label for="company" class="clab field-label">Company</label>
            <input
              id="company"
              name="company"
              type="text"
              class="field-input"
              tabindex="-1"
              autocomplete="off"
            />
          </div>
          <button type="submit" class="send-btn">SEND →</button>
          <p
            class="form-status"
            id="form-status"
            data-variant={statusVariant}
            role="status"
            aria-live="polite"
          >
            {statusMessage}
          </p>
        </form>
        <p class="contact-privacy">
          Name, email, and message are sent via Resend only to reply to your
          inquiry — never shared, never stored longer than needed to respond.
        </p>
      </div>

      <div class="contact-links">
        <a
          class="cell contact-link"
          href="https://calendly.com/shamil-dev/"
          target="_blank"
          rel="noopener noreferrer"
          >CALENDLY — BOOK 20 MIN <span class="arrow" aria-hidden="true">→</span
          ></a
        >
        <div class="cell contact-email">
          <a class="contact-link" href="mailto:hello@shamil.dev"
            >hello@shamil.dev <span class="arrow" aria-hidden="true">→</span></a
          >
          <button
            type="button"
            class="copy-btn"
            data-email="hello@shamil.dev"
            data-default-label="⧉ Copy email address"
            >⧉ Copy email address</button
          >
          <p
            class="visually-hidden"
            id="copy-announce"
            role="status"
            aria-live="polite"
          >
          </p>
        </div>
        <div class="cell contact-social">
          <a
            href="https://www.linkedin.com/in/shamil-khaibullov/"
            target="_blank"
            rel="noopener noreferrer"
            >LINKEDIN <span class="arrow" aria-hidden="true">→</span></a
          >
          <span aria-hidden="true">·</span>
          <a
            href="https://github.com/shami-dev"
            target="_blank"
            rel="noopener noreferrer"
            >GITHUB <span class="arrow" aria-hidden="true">→</span></a
          >
        </div>
      </div>
    </div>

    <TickRule variant="light" />

    <Footer data-register>
      <span class="ftl" slot="left">PORTO, PT · EU WORK PERMIT</span>
      <span class="ftl" slot="right"
        ><a href="/colophon" class="ftl-link">COLOPHON</a> · ANALYTICS ↗ · © 2026</span
      >
    </Footer>
  </div>
</BaseLayout>

<script>
  import { actions, isInputError } from "astro:actions";

  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;
  const status = document.getElementById("form-status");

  const FALLBACK_ERROR =
    "Something went wrong — please email hello@shamil.dev directly.";

  // Mirrors the server-rendered F-04 wiring (see the frontmatter) so a
  // JS-enabled resubmission looks identical to a fresh no-JS one — same
  // .field-error/aria-invalid/aria-describedby, same element it targets.
  function clearFieldErrors() {
    form?.querySelectorAll(".field-error").forEach((el) => el.remove());
    form?.querySelectorAll("[aria-invalid]").forEach((el) => {
      el.removeAttribute("aria-invalid");
      el.removeAttribute("aria-describedby");
    });
  }

  function showFieldErrors(fields: Record<string, string[] | undefined>) {
    let shown = false;
    for (const [name, messages] of Object.entries(fields)) {
      if (!messages?.length) continue;
      const input = form?.elements.namedItem(name);
      if (!(input instanceof HTMLElement)) continue;
      const id = `${name}-error`;
      const p = document.createElement("p");
      p.id = id;
      p.className = "field-error";
      p.setAttribute("role", "alert");
      p.textContent = messages.join(" ");
      input.insertAdjacentElement("afterend", p);
      input.setAttribute("aria-invalid", "true");
      input.setAttribute("aria-describedby", id);
      shown = true;
    }
    return shown;
  }

  // Progressive enhancement over the plain POST the <form> already
  // performs (Astro.getActionResult() renders that server-side, see the
  // frontmatter) — this just avoids the reload for JS-enabled clients.
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status) return;

    delete status.dataset.variant;
    clearFieldErrors();
    const { error } = await actions.contact(new FormData(form));

    if (error) {
      status.dataset.variant = "error";
      status.textContent =
        isInputError(error) && showFieldErrors(error.fields)
          ? "✗ Please fix the highlighted field(s) below."
          : "✗ " + (error.message || FALLBACK_ERROR);
      return;
    }

    status.dataset.variant = "success";
    status.textContent = "✓ Message sent — I'll reply within 24h.";
    form.reset();
  });

  const copyBtn = document.querySelector<HTMLButtonElement>(".copy-btn");
  const copyAnnounce = document.getElementById("copy-announce");
  const defaultLabel = copyBtn?.dataset.defaultLabel ?? "";
  let revertTimer: ReturnType<typeof setTimeout> | undefined;

  // A live region announces reliably; aria-live on the button itself
  // doesn't — VoiceOver races its own "activated" announcement against
  // the live-region read, and by the time it gets to the latter the
  // 2s revert had often already fired, so it read the reverted default
  // label (sometimes twice) instead of the actual confirmation.
  function announce(message: string) {
    if (!copyAnnounce) return;
    copyAnnounce.textContent = "";
    // setTimeout, not requestAnimationFrame — this doesn't need paint
    // timing, and rAF is throttled/paused whenever the tab isn't
    // actively painting (backgrounded), which would silently drop the
    // announcement instead of just delaying it.
    setTimeout(() => {
      copyAnnounce.textContent = message;
    }, 0);
  }

  copyBtn?.addEventListener("click", async () => {
    const email = copyBtn.dataset.email ?? "";
    clearTimeout(revertTimer);
    try {
      await navigator.clipboard.writeText(email);
      copyBtn.textContent = "✓ Copied";
      copyBtn.dataset.state = "copied";
      announce("Copied " + email + " to clipboard");
    } catch {
      copyBtn.textContent = "✗ Couldn't copy";
      delete copyBtn.dataset.state;
      announce("Couldn't copy — email address is " + email);
    }
    revertTimer = setTimeout(() => {
      copyBtn.textContent = defaultLabel;
      delete copyBtn.dataset.state;
    }, 2000);
  });
</script>

<style>
  /* Mock padding "28px 34px", gap "12px" x1.636 (Phase 7 scale factor).
     No .mm/.mm2 grid class on this container — MINIMAL intensity. */
  .contact {
    gap: 20px;
    padding: 46px var(--col-pad);
  }

  @media (width < 64rem) {
    .contact {
      gap: var(--space-3);
      padding: var(--space-4) var(--col-pad);
    }
  }

  /* Mock line-height 1.7, color #6f6a5e -> --label */
  .contact-avail {
    font-family: var(--font-mono);
    font-size: var(--fs-mono); /* 13px floor, mock 8.5px */
    color: var(--label);
    line-height: 1.7;
  }

  /* Mock gap "16px" x1.636 */
  .contact-row {
    display: flex;
    gap: 26px;
  }
  @media (width < 40rem) {
    .contact-row {
      flex-direction: column;
    }
  }

  /* Mock gap "8px" x1.636 */
  .contact-form-card {
    flex: 1.4;
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  /* <form> itself has no display:flex, so .field divs stack via plain
     block flow with zero margin between them — .contact-form-card's own
     gap (above) only separates its direct children (.clab, <form>,
     .contact-privacy), never reaching inside the form. --space-5 (20px)
     rather than a smaller step: the global :focus-visible ring (2px
     outline, 2px offset = 4px beyond the input's own box) needs
     headroom on both sides of that gap without touching the field it's
     reaching toward. */
  .field + .field {
    margin-top: var(--space-5);
  }
  .field-label {
    color: var(--ink);
  }
  /* Same size as .form-status; bold (not colour) carries the "something's
     wrong" signal — see form-status[data-variant="error"] below for why. */
  .field-error {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 600;
    color: var(--ink);
  }
  /* Mock border color #c8bfa8 -> --chip-bd, radius 2px, padding "7px 9px" x1.636 */
  .field-input {
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    color: var(--ink);
    background: var(--white);
    border: 1px solid var(--chip-bd);
    border-radius: 2px;
    padding: 11px 15px;
  }
  .field-textarea {
    min-height: 92px; /* mock 56px x1.636 */
    resize: vertical;
    font-family: inherit;
  }

  /* Hard action (drafting register): sharp corners, instant hover swap —
     same register as About's RESUME.PDF button. Mock padding "10px" x1.636 */
  .send-btn {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-lg); /* 16px, mock 10px */
    font-weight: 600;
    letter-spacing: var(--ls-wide);
    text-align: center;
    color: var(--white);
    background: var(--ink);
    padding: 16px;
    border: none;
    cursor: pointer;
    /* Extra breathing room above the button, on top of the card's own
       gap — the mock's tighter rhythm reads as cramped once real focus
       rings/type are in play. */
    margin-top: var(--space-5);
  }
  .send-btn:hover,
  .send-btn:focus-visible {
    background: var(--blue);
  }

  .form-status:not(:empty) {
    font-family: var(--font-mono);
    font-size: var(--fs-mono); /* 13px floor */
    color: var(--label);
  }
  /* "✗"/"✓" glyphs (set in the frontmatter/script) carry the meaning —
     colour stays supplementary (WCAG 1.4.1). --maroon measures only
     3.39:1 in anoitecer at this text size (tokens.css), below AA's
     4.5:1 for normal text, so error text stays --ink + bold instead of
     red. data-variant (not a BEM class) matches the .copy-btn
     convention below, and its attribute selector is specific enough to
     outrank :not(:empty) above. */
  .form-status[data-variant="error"] {
    color: var(--ink);
    font-weight: 600;
  }
  /* --green-raised is AA-verified in all three modes (tokens.css) — same
     token the .copy-btn success state uses below. */
  .form-status[data-variant="success"] {
    color: var(--green-raised);
  }

  /* Mock font-size 7.5px, clamped to the 13px floor (Phase 7 F-02) */
  .contact-privacy {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--label);
  }

  /* Mock gap "10px" x1.636 */
  .contact-links {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .contact-link {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-lg); /* 16px, mock 10px */
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }

  .contact-email {
    display: flex;
    flex-direction: column;
    gap: 10px; /* mock margin-top "6px" x1.636 */
  }

  /* Mock font-size 9.5px, color #2a5f9e. --blue-raised (not --blue) —
     this cell is raised (--white), where anoitecer's plain --blue
     measures 4:1, below AA (a11y gate finding). */
  .copy-btn {
    font-family: var(--font-mono);
    font-size: var(--fs-kicker); /* 15px */
    color: var(--blue-raised);
    background: none;
    border: none;
    padding: 8px 0;
    /* <button> defaults to text-align: center in the UA stylesheet;
       stretched full-width by .contact-email's flex column, that
       centered the label instead of flushing it left under the email
       link above it. */
    text-align: left;
    cursor: pointer;
  }
  /* Same --green-raised (not --green) reasoning as --blue-raised above
     — this cell's --white ground is a raised surface. */
  .copy-btn[data-state="copied"] {
    color: var(--green-raised);
  }

  .contact-social {
    display: flex;
    gap: 8px;
    align-items: baseline;
  }
  .contact-social a {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-lg); /* 16px, mock 10px */
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }
  .contact-social span {
    color: var(--label);
  }
  /* Shared by all four arrow-suffixed links (Calendly, email,
     LinkedIn, GitHub) — same "opens/goes to" register throughout
     .contact-links, not just the two social ones. transition lives on
     the base rule (not inside :hover) so the arrow animates back on
     mouse-leave too, not just snapping — same pattern as
     .dcard.is-hoverable in global.css. */
  .contact-links .arrow {
    display: inline-block;
    transition: transform var(--t-hover) var(--e-out);
  }
  @media (hover: hover) {
    .contact-links a:hover .arrow,
    .contact-links a:focus-visible .arrow {
      transform: translateX(3px);
    }
  }
</style>
