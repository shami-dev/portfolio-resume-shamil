---
// About (Phase 5 §5.4) — LIGHT intensity: major grid lines only (.mm2),
// the same faded-texture class as /colophon, distinct from the case
// pages' full .mm grid and Home's grid-fades-below-the-hero split.
// RESUME.PDF is the rail's heaviest element (Phase 7 KPI 1) — sharp
// corners, drafting register, per the radius rule (hard actions never
// get the 4px software-register radius).
import BaseLayout from "../layouts/BaseLayout.astro";
import Rail from "../components/Rail.astro";
import Nav from "../components/Nav.astro";
import TickRule from "../components/TickRule.astro";
import Plate from "../components/Plate.astro";
import portrait from "../assets/portrait-shamil.jpg";
import SiteFooter from "../components/SiteFooter.astro";

// Roles only — the Jun 2018–Feb 2020 gap (unfinished CS Master's,
// redirected into Automotive Engineering, no Germany semester) is
// deliberately omitted from this timeline rather than shown as a 5th
// station. Durations/offsets and each station's start-year tag are
// computed from these dates rather than hand-typed, so the WEB DEVELOPER
// station and the total-years figure above the track stay correct as the
// site rebuilds over time instead of quietly going stale (previously
// hardcoded as "4 YRS", off by roughly a year against the real Dec 2009
// start).
//
// Labels are the legal job titles from the original resume, not thematic
// paraphrases — Design Engineer's two grades (Category III then Category
// II) collapse into one station under the later, higher grade, since no
// exact promotion date is on record to split them.
const roles = [
  {
    label: "Design Engineer",
    start: new Date(2009, 11, 1),
    end: new Date(2013, 0, 1),
    accent: false,
  },
  {
    label: "Head of the Design Bureau",
    start: new Date(2013, 2, 1),
    end: new Date(2018, 5, 1),
    accent: false,
  },
  {
    label: "IT Support Expert",
    start: new Date(2020, 1, 1),
    end: new Date(2022, 2, 1),
    accent: false,
  },
  {
    label: "Web Developer",
    start: new Date(2022, 3, 1),
    end: new Date(),
    accent: true,
  },
] as const;

const MS_PER_YEAR = 365.25 * 24 * 60 * 60 * 1000;
const yearsBetween = (a: Date, b: Date) =>
  (b.getTime() - a.getTime()) / MS_PER_YEAR;

const durations = roles.map((r) => yearsBetween(r.start, r.end));
const totalYears = durations.reduce((sum, y) => sum + y, 0);
const totalYearsRounded = Math.round(totalYears);

let cumulative = 0;
const stations = roles.map((role, i) => {
  const offset = (cumulative / totalYears) * 100;
  cumulative += durations[i];
  const startYear = role.start.getFullYear();
  return {
    label: role.label,
    sub: role.accent ? `${startYear} - NOW` : `${startYear}`,
    offset: `${offset.toFixed(1)}%`,
    accent: role.accent,
  };
});

const title = `About — ${totalYearsRounded} years, one arc · Shamil Khaibullov`;
const description =
  "CAD engineer → design-team manager → 500+ ATMs at 97%+ uptime → web. The arc is the argument. Resume as a direct PDF.";

// Absolute, not "/resume.pdf" — copied for pasting into an email or chat,
// where a relative path resolves against whatever page it's read from.
// A "/resume" short-link via public/_redirects was tried and reverted:
// Cloudflare's _redirects only resolves under workerd (astro preview /
// production), not plain `astro dev` (Vite) — every-day `pnpm dev` use
// would 404 on a link that works in production, which is worse than the
// few characters a short link saves.
const resumeUrl = new URL("/resume.pdf", Astro.site).href;

// Same source as the timeline, rounded for prose — so this sentence
// can't drift out of sync with the stations again the way "4 years / 4
// more / 2 years" had (real durations are 3y2mo / 5y4mo / 2y1mo).
const [cadYears, managerYears, atmYears] = durations.map((d) => Math.round(d));
---

<BaseLayout title={title} description={description} motion>
  <Rail
    label="About Shamil"
    labelRight="Porto · EU"
    scan={false}
    class="rail-about"
  >
    <div class="about-id-cells">
      <div class="cell-pair">
        <div class="cell">
          <div class="clab">LOCATION</div>
          <div class="cell-val-mono">Porto, GMT</div>
        </div>
        <div class="cell">
          <div class="clab">W. PERMIT</div>
          <div class="cell-val-mono">Portugal</div>
        </div>
        <div class="cell">
          <div class="clab">TRACK</div>
          <div class="cell-val-mono">{totalYearsRounded} years</div>
        </div>
      </div>
    </div>
    <Nav current="about" slot="nav" />
    <div class="rail-foot about-resume-rail" slot="extras">
      <a
        href={resumeUrl}
        class="resume-btn"
        target="_blank"
        rel="noopener noreferrer"
      >
        RESUME.PDF ↓
      </a>
    </div>
  </Rail>

  <div class="mm2 col about">
    <div class="about-hero">
      <h1 class="h1-case about-h1" data-register>
        Eleven years in engineering got me here.
      </h1>

      <div class="about-intro">
        <div class="prose about-body" data-register>
          <p>
            I'm a web developer in Porto, building fast, accessible web
            applications using Full-Stack Web Frameworks with TypeScript and
            React.
          </p>
          <p>
            Before that: {cadYears} years as a computer-aided design (CAD) engineer,
            then {managerYears} more managing the CAD design team, then {" "}{
              atmYears
            } years keeping over 500 ATM (cash machine) and payment-kiosk systems
            running at 97%+ uptime — individual contributor to team lead to the person
            on call when one of those machines went down.
          </p>
          <p>
            That carried straight into web work. I've run the technical
            infrastructure behind international conferences serving 500+
            attendees across 15 countries, end to end — frontend, backend, and
            infrastructure, with no one else to hand it to. I've also built
            sites for real organizations and individuals working under real
            deadlines — conference registration, an election campaign — plus two
            side projects built on the OpenAI API in my own time: a receipts
            analyzer and an IELTS feedback tool, both shipped and measured in
            the open.
          </p>
          <p>
            I hold a Portuguese work permit, so hiring me in Portugal needs no
            sponsorship. For teams elsewhere, I work remotely from Porto on
            cross-border business-to-business (B2B) contracts across the
            European Union.
          </p>
        </div>
        <div class="about-portrait-col">
          <Plate
            src={portrait}
            alt="Shamil Khaibullov"
            ratio="portrait"
            priority
            class="portrait-fig"
            data-register="lg"
            sizes="(min-width: 64rem) 245px, (min-width: 48rem) 240px, 100vw"
          />
          <div class="about-resume-inline" data-register>
            <a
              href={resumeUrl}
              class="resume-btn"
              target="_blank"
              rel="noopener noreferrer"
            >
              RESUME.PDF ↓
            </a>
            <button
              type="button"
              class="copy-btn"
              id="resume-copy-btn"
              data-resume-url={resumeUrl}
              data-default-label="⧉ Copy resume link"
            >
              ⧉ Copy resume link
            </button>
            <p
              class="visually-hidden"
              id="resume-copy-announce"
              role="status"
              aria-live="polite"
            >
            </p>
          </div>
        </div>
      </div>
    </div>

    <h2 class="klab" data-register>
      CAREER TRACK — {totalYearsRounded} YEARS ON ONE SCALE · STATION MARKS AT TRANSITIONS
    </h2>

    <div class="about-track" data-register="lg">
      <TickRule style="position: absolute; left: 0; right: 0; bottom: 0" />
      {
        stations.map((station) => (
          <div class="track-station" style={`left: ${station.offset}`}>
            <div
              class={
                station.accent ? "track-mark track-mark-accent" : "track-mark"
              }
            />
            <div class="track-label">
              <div
                class={
                  station.accent
                    ? "track-label-name track-label-name-accent"
                    : "track-label-name"
                }
              >
                {station.label}
              </div>
              <div class="track-label-sub">{station.sub}</div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="about-cols" data-register>
      <div class="about-col">
        <h2 class="klab">SKILLS</h2>
        <ul class="prose about-skills">
          <li>
            <strong>Front-end:</strong> Astro, React, React Router 7 / Remix, TypeScript,
            Tailwind CSS
          </li>
          <li>
            <strong>Back-end:</strong> Node, Express, Prisma, PostgreSQL, Zod
          </li>
          <li><strong>AI:</strong> OpenAI API, prompt engineering</li>
          <li><strong>Ops:</strong> Vercel, Cloudflare, Git/GitHub, CI/CD</li>
        </ul>
      </div>
      <div class="about-col">
        <h2 class="klab">RECOGNITIONS</h2>
        <ul class="about-recognitions">
          <li class="prose about-quote">
            <span class="quote-text"
              >"…ownership, vision, and a crash-free launch of the conference
              website."</span
            > — Paola Perina, Public Relations Manager at MALTALINK 2025 ·{" "}
            <a
              href="https://www.linkedin.com/feed/update/urn:li:activity:7351231847005089795/"
              target="_blank"
              rel="noopener noreferrer"
            >
              View on LinkedIn ↗
            </a>
          </li>
          <li class="prose about-recognition">
            <a
              href="/certificate-district109.pdf"
              target="_blank"
              rel="noopener noreferrer">Certificate of appreciation</a
            > for outstanding leadership & teamwork from Katia Burdet, Program Quality
            Director, District 109 (2024-25)
          </li>
        </ul>
      </div>
    </div>

    <a
      href={resumeUrl}
      class="resume-btn about-resume-end"
      target="_blank"
      rel="noopener noreferrer"
      data-register
    >
      RESUME.PDF ↓
    </a>

    <SiteFooter data-register />
  </div>
</BaseLayout>

<style>
  /* Mock padding "28px 34px", gap "13px" x1.636 (Phase 7 scale factor) */
  .about {
    gap: 21px;
    padding: 46px var(--col-pad);
  }

  @media (width < 48rem) {
    .about {
      gap: var(--space-3);
      padding: var(--space-4) var(--col-pad);
    }
  }

  /* Tablet (spec §8.5, phase_5c_tablet_layouts.html:538-541): LOC/AUTH/
     TRACK sit in one unwrapped row, like every other band's title-block
     cells — overriding .cell-pair's own nth-child(n+3) rule, which
     exists for the narrow 300px desktop rail column this row doesn't
     have to fit at this width. */
  @media (48rem <= width < 64rem) {
    .about-id-cells .cell-pair {
      flex-wrap: nowrap;
      gap: 6px;
    }
    .about-id-cells .cell-pair > .cell {
      flex: none;
      padding: var(--cell-pad);
    }
  }

  /* Mobile: the static bar (Rail's label/labelRight) already carries
     name and location compactly — these full cells would just repeat
     it. */
  @media (width < 48rem) {
    .about-id-cells {
      display: none;
    }
  }

  /* Invisible everywhere except tablet (below) — desktop/mobile keep
     .about-h1 and .about-intro as today's plain stacked siblings of
     .col.about; tablet dissolves this instead to pull .about-h1 into
     the row beside the photo, level with it. */
  .about-hero {
    display: contents;
  }

  /* Body + portrait row, mock gap "18px" x1.636. .about-body is a direct
     flex child now — it was .about-copy's job to grow/clamp before .h1
     moved out of this row entirely. */
  .about-intro {
    display: flex;
    gap: 29px;
  }
  /* Mock margin-top "8px" x1.636 — was .about-copy's own heading-to-body
     gap; .h1-case sits outside .about-intro now, so this reads as the
     row's own top offset instead. Written after the plain .about-intro
     rule above so stylelint's specificity-order check reads it as the
     (correctly) more specific override it is. */
  .about-h1 + .about-intro {
    margin-top: 13px;
  }
  .about-body {
    flex: 1;
    min-width: 0;
  }
  /* .about-body is now a multi-paragraph div (was a single <p>) — gap
     between its own children, not touching .about-intro's row gap. */
  .about-body p + p {
    margin-top: 13px;
  }

  /* Column-only: the rail keeps its own resume block for desktop/tablet
     (unchanged), so this stays out of the way until .about-resume-rail
     is hidden below. */
  .about-resume-inline {
    display: none;
  }

  /* Wraps the photo + inline resume block as one column, matching the
     mockup's own grouping (phase_5c_tablet_layouts.html:566) — flex:
     none so it never grows in the .about-intro row; width/gap vary per
     breakpoint below. */
  .about-portrait-col {
    display: flex;
    flex-direction: column;
    flex: none;
  }

  /* Desktop: fixed width beside the copy. Width only — the 5:6 crop
     that used to live here moved to .plate-mount-portrait (global.css)
     when this became a <Plate>, because the ratio now has to land on
     the <img> nested inside the mount, and Astro scopes a component's
     styles to its root element only. A scoped `.portrait-fig .plate-img`
     rule would compile with this file's cid and never match. */
  .portrait-fig {
    width: 245px;
  }

  /* Tablet (spec §8.5, phase_5c_tablet_layouts.html:561-570): portrait
     stays beside the copy, narrower than desktop's 245px — the intro is
     the one block that pays the cost of the fixed-width figure, running
     424px (~47 characters, low end of range but inside it); everything
     below it resumes the 640px cap. RESUME.PDF moves to a second
     on-page instance here too (KPI 1, "twice"), stacked directly under
     the photo in the same 240px column per the mock — the rail block
     hides, and so does the .rail-extras wrapper it leaves behind empty
     (global.css, same media query).

     .about-hero becomes the real two-column grid here (the mock's own
     row, phase_5c_tablet_layouts.html:561, wraps .h1 in with the copy)
     — .about-intro dissolves into it in turn so .about-body and
     .about-portrait-col join .about-h1 as grid items of the same
     container, letting the photo span both rows and land level with
     the heading instead of the paragraph beneath it. align-items: start
     still matters here: without it the grid's stretch default drags the
     portrait's height off its ratio (stretch resolves the auto cross
     size before aspect-ratio gets a say), same as flex's version of the
     same bug. The ratio sits on .plate-img now rather than on
     .portrait-fig, but the figure still takes its height from that
     child, so stretch reaches it the same way. */
  @media (48rem <= width < 64rem) {
    .about-hero {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 13px 24px;
      align-items: start;
    }
    .about-h1 {
      grid-column: 1;
      grid-row: 1;
    }
    .about-intro {
      display: contents;
    }
    .about-body {
      grid-column: 1;
      grid-row: 2;
    }
    .about-portrait-col {
      grid-column: 2;
      grid-row: 1 / span 2;
      width: 240px;
      gap: 10px;
    }
    .portrait-fig {
      width: 100%;
    }
    .about-resume-inline {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .about-resume-rail {
      display: none;
    }
    .about-cols {
      gap: 24px;
    }
  }

  /* Desktop: same grid mechanics as tablet above (photo spans both rows,
     landing level with the H1 instead of sitting beside the paragraph),
     kept as its own block rather than widening the tablet query because
     desktop keeps its own portrait sizing (245px/5:6, set unconditionally
     above) and keeps the rail's RESUME.PDF instance visible — tablet
     hides that block since its inline instance replaces it; here the
     inline instance under the photo is a second, additive one. */
  @media (width >= 64rem) {
    .about-hero {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 13px 29px;
      align-items: start;
    }
    .about-h1 {
      grid-column: 1;
      grid-row: 1;
    }
    .about-intro {
      display: contents;
    }
    .about-body {
      grid-column: 1;
      grid-row: 2;
    }
    .about-portrait-col {
      grid-column: 2;
      grid-row: 1 / span 2;
      gap: 10px;
    }
    .about-resume-inline {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
  }

  @media (width < 48rem) {
    .about-intro {
      flex-direction: column;
      /* M-P8's own flex column runs a uniform 14px gap between photo,
         resume button and prose — mock 14px x1.44 (Phase 7 mobile
         factor) lands on --space-5, well under desktop's inherited
         29px carried over from the two-column row above. */
      gap: var(--space-5);
    }
    /* Photo (+ its stacked resume button) right after the H1, prose
       last — request order, not DOM order (.about-body has to stay
       first in the DOM for .about-body's own :first-of-type/reading
       flow elsewhere, so this reorders instead of moving markup). */
    .about-portrait-col {
      width: 100%;
      order: 0;
    }
    /* M-P8: full-width. The 4:5 crop it takes here (shallower than
       desktop's 5:6, since a 245px-tall portrait at full mobile width
       would run nearly a viewport) is set by .plate-mount-portrait's
       own below-64rem override in global.css. */
    .portrait-fig {
      width: 100%;
    }
    .about-body {
      order: 1;
    }
    /* The column's own resume block (above) takes over the KPI-1 job at
       this width — showing the rail's copy too would be a second,
       redundant resume prompt stacked right above it. */
    .about-resume-rail {
      display: none;
    }
  }

  /* Ruled-track timeline: relative box. All four station labels align
     at one height above the tick rule (no zigzag stagger) — height is
     sized for one label's two text lines plus clearance above. */
  .about-track {
    position: relative;
    height: 100px;
    margin-top: 18px;
  }
  .track-station {
    position: absolute;
    bottom: 0;
  }
  /* Mock width "2.5px", height "20px" x1.636 */
  .track-mark {
    width: 4px;
    height: 33px;
    background: var(--label);
  }
  .track-mark-accent {
    background: var(--green);
  }
  /* .track-station has no explicit width (nothing needs one — .track-mark
     is a fixed 4px, and this label is absolutely positioned so it takes
     itself out of the shrink-to-fit calculation)... except that "taking
     itself out" cuts both ways: .track-label's own containing block IS
     .track-station, so with no in-flow sibling wider than 4px, its
     available width collapsed to ~4px too — forcing even "CAD ENGINEER"
     to wrap onto four lines. width: max-content sizes it off its own
     content instead of that collapsed parent. max-width is a ceiling,
     not the binding constraint for any station today — IT EXPERT sits
     only ~119px (≈14% of the track) from WEB — NOW, which is why that
     station's label/note were kept short enough to clear it unwrapped;
     a longer label there would need this number revisited. */
  .track-label {
    position: absolute;
    left: 0;
    bottom: 43px; /* mock 26px x1.636 */
    width: max-content;
    max-width: 140px;
  }
  .track-label-name {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-md); /* 14px, mock 9px */
    font-weight: 600;
    color: var(--blue);
  }
  .track-label-name-accent {
    color: var(--green);
  }
  .track-label-sub {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--fs-mono); /* 13px floor, mock 8px */
    color: var(--label);
  }

  /* Tablet (spec §8.5): the horizontal ruled track survives at 688px
     with desktop's exact station positions — no inferred year ranges
     needed (closes Phase 5b F7). Track height is desktop 134px [mock 82]
     x0.70 = 93.8, rounded to 94.

     All four labels share one row, not the mock's alternating two
     heights — that pattern was tuned to ITS hypothetical 4/4/2/4-year
     data, where CAD ENGINEER/CAD MANAGER was the tight pair. This
     page's real, computed durations put the collision risk elsewhere:
     measured via getBoundingClientRect, only stations 3-4 (IT EXPERT /
     WEB — NOW) overlap (-3.8px) at the same row; 1-2 and 2-3 clear by
     48px and 118px. Rather than raise station 4 to a second height,
it's nudged right (margin-left) just enough to clear the overlap
     sideways, keeping every title on the same baseline. Durations shift
     slightly every month (station 4's end date is "now"), which only
     widens the 3-4 gap over time, not narrows it, so this doesn't need
     revisiting on a schedule — but re-check with getBoundingClientRect
if a 5th role is ever added or an early station's dates change. */
  @media (48rem <= width < 64rem) {
    .about-track {
      height: 94px;
    }
    .track-label {
      bottom: 38px;
    }
    /* Same row as every other label — the ~4px collision with IT EXPERT
       (measured via getBoundingClientRect) is cleared sideways instead
       of by raising this one above the row. */
    .track-station:last-child .track-label {
      margin-left: 8px;
    }
  }

  /* Below 48rem, the percentage-offset stations sit too close together
     for real (F-02-floor) text — IT EXPERT and WEB — NOW are only ~14%
     apart and start colliding. Phase 5b 6.4 (Option A, chosen over a
     horizontal-scroll or compressed-in-place track — both rejected
     there) rotates the track 90°: the horizontal tick-rule becomes a
     vertical ruled column on the left, station marks become short
     horizontal ticks off it, and continuity — the whole point of the
     component — survives the rotation because it's carried by the
     unbroken rule, not the axis.

     A CSS Grid version (rule at grid-column 1, grid-row: 1 / -1, spanning
     the auto-placed stations in column 2) was tried first and measured
     wrong: the rule resolved to a single row with zero height instead of
     spanning all of them — mixing one explicitly-placed spanning item
     with several auto-placed items in the same grid doesn't reliably
     resolve `-1` against a row count the auto-placed items haven't
     established yet. Absolute positioning sidesteps the ambiguity
     entirely: .about-track's height comes purely from the stations'
     normal flow (the absolutely positioned rule doesn't contribute to
     it), and top: 0; bottom: 0 then stretches the rule to match whatever
     that resolves to, with no row count involved on either side. */
  @media (width < 48rem) {
    .about-track {
      position: relative;
      height: auto;
    }
    /* Reoriented from a horizontal rule (border-bottom + a 90deg
       left-to-right gradient) to a vertical one: border-right, and the
       gradient's default top-to-bottom angle left implicit, exactly the
       M-P8 frame's own left-column spec. */
    .about-track > .tick {
      position: absolute;
      inset: 0 auto 0 0;
      width: 15px;
      height: auto;
      border-bottom: 0;
      border-right: 1.5px solid var(--tick-ink);
      background-image:
        repeating-linear-gradient(var(--tick-ink) 0 1px, transparent 1px 25px),
        repeating-linear-gradient(
          var(--tick-ink-minor) 0 1px,
          transparent 1px 5px
        );
      background-size:
        11px 100%,
        5px 100%;
      background-position: right, right;
      background-repeat: repeat-y;
    }
    .track-station {
      position: static;
      display: flex;
      align-items: flex-start;
      gap: var(--space-3);
      padding-bottom: var(--space-5);
    }
    .track-station:last-child {
      padding-bottom: 0;
    }
    /* Mock width "20px", height "2.5px" — a short horizontal dash
       bridging from the rule's right edge (margin-left: 15px, the
       rule's own width, so there's no gap between them) to the label,
       not the desktop mark's own vertical tick. margin-top roughly
       aligns it with the label's cap-height instead of its box top. */
    .track-mark {
      width: 20px;
      height: 2.5px;
      flex: none;
      margin-top: 8px;
      margin-left: 15px;
    }
    .track-label {
      position: static;
      width: auto;
      max-width: none;
    }
  }

  /* Skills / recognition row, mock gap "20px" x1.636 */
  .about-cols {
    display: flex;
    gap: 33px;
  }
  .about-col {
    flex: 1;
    min-width: 0;
  }
  @media (width < 48rem) {
    .about-cols {
      flex-direction: column;
    }
  }

  /* Mock margin-top "6px" x1.636, line-height 1.8 verbatim */
