</style>

<script>
  // Mirrors Contact's copy-email script (that page's own inline
  // <script>, not shared — see the .copy-btn CSS comment above for why).
  const copyBtn = document.querySelector<HTMLButtonElement>("#resume-copy-btn");
  const copyAnnounce = document.getElementById("resume-copy-announce");
  const defaultLabel = copyBtn?.dataset.defaultLabel ?? "";
  let revertTimer: ReturnType<typeof setTimeout> | undefined;

  function announce(message: string) {
    if (!copyAnnounce) return;
    copyAnnounce.textContent = "";
    setTimeout(() => {
      copyAnnounce.textContent = message;
    }, 0);
  }

  copyBtn?.addEventListener("click", async () => {
    const url = copyBtn.dataset.resumeUrl ?? "";
    clearTimeout(revertTimer);
    try {
      await navigator.clipboard.writeText(url);
      copyBtn.textContent = "✓ Copied";
      copyBtn.dataset.state = "copied";
      announce("Copied " + url + " to clipboard");
    } catch {
      copyBtn.textContent = "✗ Couldn't copy";
      delete copyBtn.dataset.state;
      announce("Couldn't copy — resume link is " + url);
    }
    revertTimer = setTimeout(() => {
      copyBtn.textContent = defaultLabel;
      delete copyBtn.dataset.state;
    }, 2000);
  });
</script>
