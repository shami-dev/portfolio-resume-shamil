---
// About (Phase 5 §5.4) — LIGHT intensity: major grid lines only (.mm2),
// the same faded-texture class as /colophon, distinct from the case
// pages' full .mm grid and Home's grid-fades-below-the-hero split.
// RESUME.PDF is the rail's heaviest element (Phase 7 KPI 1) — sharp
// corners, drafting register, per the radius rule (hard actions never
// get the 4px software-register radius).
import BaseLayout from "../layouts/BaseLayout.astro";
import Rail from "../components/Rail.astro";
import Nav from "../components/Nav.astro";
import TickRule from "../components/TickRule.astro";
import Placeholder from "../components/Placeholder.astro";
import Footer from "../components/Footer.astro";

// Roles only — the Jun 2018–Feb 2020 gap (unfinished CS Master's,
// redirected into Automotive Engineering, no Germany semester) is
// deliberately omitted from this timeline rather than shown as a 5th
// station. Durations/offsets are computed from these dates rather than
// hand-typed, so the "WEB — NOW" duration and the total-years figure
// above the track stay correct as the site rebuilds over time instead
// of quietly going stale (previously hardcoded as "4 YRS", off by
// roughly a year against the real Dec 2009 start).
const roles = [
  {
    label: "CAD ENGINEER",
    note: "IC",
    start: new Date(2009, 11, 1),
    end: new Date(2013, 1, 1),
    accent: false,
  },
  {
    label: "CAD MANAGER",
    note: "LED TEAM",
    start: new Date(2013, 1, 1),
    end: new Date(2018, 5, 1),
    accent: false,
  },
  {
    // Real title (not the thematic "ATM Reliability" paraphrase) — also
    // just short enough, at this station's tight ~119px gap to the next
    // one, to fit its line without wrapping. "97%+" (not "UPTIME") for
    // the same reason on the sub line; the word itself is already in
    // the prose paragraph above.
    label: "IT EXPERT",
    note: "97%+",
    start: new Date(2020, 1, 1),
    end: new Date(2022, 2, 1),
    accent: false,
  },
  {
    label: "WEB — NOW",
    note: "REACT/TS",
    start: new Date(2022, 3, 1),
    end: new Date(),
    accent: true,
  },
] as const;

const MS_PER_YEAR = 365.25 * 24 * 60 * 60 * 1000;
const yearsBetween = (a: Date, b: Date) =>
  (b.getTime() - a.getTime()) / MS_PER_YEAR;
const formatDuration = (years: number) => {
  const wholeYears = Math.floor(years);
  const months = Math.round((years - wholeYears) * 12);
  if (months === 0) return `${wholeYears}Y`;
  if (months === 12) return `${wholeYears + 1}Y`;
  return `${wholeYears}Y ${months}MO`;
};

const durations = roles.map((r) => yearsBetween(r.start, r.end));
const totalYears = durations.reduce((sum, y) => sum + y, 0);
const totalYearsRounded = Math.round(totalYears);

let cumulative = 0;
const stations = roles.map((role, i) => {
  const offset = (cumulative / totalYears) * 100;
  cumulative += durations[i];
  return {
    label: role.label,
    sub: `${formatDuration(durations[i])} · ${role.note}`,
    offset: `${offset.toFixed(1)}%`,
    accent: role.accent,
  };
});

const title = `About — ${totalYearsRounded} years, one arc · Shamil Khaibullov`;
const description =
  "CAD engineer → design-team manager → 500+ ATMs at 97%+ uptime → web. The arc is the argument. Resume as a direct PDF.";

// Same source as the timeline, rounded for prose — so this sentence
// can't drift out of sync with the stations again the way "4 years / 4
// more / 2 years" had (real durations are 3y2mo / 5y4mo / 2y1mo).
const [cadYears, managerYears, atmYears] = durations.map((d) => Math.round(d));
---

<BaseLayout title={title} description={description} motion>
  <Rail>
    <div class="cell">
      <div class="clab">NAME</div>
      <div class="cell-name">Shamil Khaibullov</div>
    </div>
    <div class="cell-pair">
      <div class="cell">
        <div class="clab">LOC</div>
        <div class="cell-val-mono">Porto, PT</div>
      </div>
      <div class="cell">
        <div class="clab">AUTH</div>
        <div class="cell-val-mono">EU permit</div>
      </div>
    </div>
    <Nav current="about" />
    <div class="rail-foot">
      <a href="/resume.pdf" class="resume-btn">RESUME.PDF ↓</a>
      <p class="resume-caption">direct file URL — forwardable</p>
    </div>
  </Rail>

  <div class="mm2 col about">
    <div class="about-intro">
      <div class="about-copy">
        <h1 class="h1-case" data-register>The arc is the argument.</h1>
        <p class="prose about-body" data-register>
          I'm a web developer in Porto building fast, accessible
          React/TypeScript applications. Before development: {cadYears} years as a
          CAD engineer, {managerYears} more managing the design team, then {
            atmYears
          } years keeping 500+ ATM and payment-kiosk systems at 97%+ uptime. That
          arc — IC to lead to reliability — is where the instinct for ownership and
          end-to-end responsibility comes from. I've carried it into web work since:
          running the technical infrastructure behind international conferences serving
          500+ attendees across 15 countries, usually as the only person responsible
          for the whole stack, alongside sites built for real organizations and individuals
          with real deadlines — conferences, election campaigns — and self-directed
          projects integrating AI into working products. Schengen residence card,
          Portuguese work permit; remote and cross-border B2B across the EU.
        </p>
      </div>
      <Placeholder
        slug="portrait-shamil"
        kind="PORTRAIT — SUPPLIED SEPARATELY"
        style="width: 245px; aspect-ratio: 5 / 6; flex: none"
        data-register="lg"
      />
    </div>

    <div class="klab about-track-label" data-register>
      CAREER TRACK — {totalYearsRounded} YEARS ON ONE SCALE · STATION MARKS AT TRANSITIONS
    </div>

    <div class="about-track" data-register="lg">
      <TickRule style="position: absolute; left: 0; right: 0; bottom: 0" />
      {
        stations.map((station) => (
          <div class="track-station" style={`left: ${station.offset}`}>
            <div
              class={
                station.accent ? "track-mark track-mark-accent" : "track-mark"
              }
            />
            <div class="track-label">
              <div
                class={
                  station.accent
                    ? "track-label-name track-label-name-accent"
                    : "track-label-name"
                }
              >
                {station.label}
              </div>
              <div class="track-label-sub">{station.sub}</div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="about-cols" data-register>
      <div class="about-col">
        <div class="klab">SKILLS — GROUPED</div>
        <p class="prose about-skills">
          <strong>Front-end:</strong> React, TypeScript, Astro, Tailwind
          <br />
          <strong>Back-end:</strong> Node, Express, Prisma, PostgreSQL, Zod
          <br />
          <strong>AI:</strong> OpenAI API, prompt engineering
          <br />
          <strong>Ops:</strong> Vercel, Cloudflare, GitHub CI
        </p>
      </div>
      <div class="about-col">
        <div class="klab">RECOGNITION</div>
        <p class="prose about-quote">
          "…ownership, vision, and a crash-free launch." — public LinkedIn
          recommendation, MALTALINK 2025
        </p>
        <p class="prose about-recognition">
          Certificate of appreciation for outstanding leadership & teamwork ·
          Toastmasters speaker
        </p>
      </div>
    </div>

    <TickRule variant="light" />

    <Footer data-register>
      <a href="/colophon" class="ftl" slot="left"
        >HOW THIS SITE WAS BUILT → COLOPHON</a
      >
      <span class="ftl" slot="right">ANALYTICS ↗ · © 2026</span>
    </Footer>
  </div>
</BaseLayout>

<style>
  /* Mock padding "28px 34px", gap "13px" x1.636 (Phase 7 scale factor) */
  .about {
    gap: 21px;
    padding: 46px var(--col-pad);
  }

  @media (width < 64rem) {
    .about {
      gap: var(--space-3);
      padding: var(--space-4) var(--col-pad);
    }
  }

  /* Copy + portrait row, mock gap "18px" x1.636 */
  .about-intro {
    display: flex;
    gap: 29px;
  }
  .about-copy {
    flex: 1;
    min-width: 0;
  }
  /* Mock margin-top "8px" x1.636 */
  .about-body {
    margin-top: 13px;
  }

  @media (width < 40rem) {
    .about-intro {
      flex-direction: column;
    }
  }

  /* Mock margin-top "4px" x1.636 */
  .about-track-label {
    margin-top: 7px;
  }

  /* Ruled-track timeline: relative box. All four station labels align
     at one height above the tick rule (no zigzag stagger) — height is
     sized for one label's two text lines plus clearance above. */
  .about-track {
    position: relative;
    height: 100px;
    margin-top: 18px;
  }
  .track-station {
    position: absolute;
    bottom: 0;
  }
  /* Mock width "2.5px", height "20px" x1.636 */
  .track-mark {
    width: 4px;
    height: 33px;
    background: var(--label);
  }
  .track-mark-accent {
    background: var(--green);
  }
  /* .track-station has no explicit width (nothing needs one — .track-mark
     is a fixed 4px, and this label is absolutely positioned so it takes
     itself out of the shrink-to-fit calculation)... except that "taking
     itself out" cuts both ways: .track-label's own containing block IS
     .track-station, so with no in-flow sibling wider than 4px, its
     available width collapsed to ~4px too — forcing even "CAD ENGINEER"
     to wrap onto four lines. width: max-content sizes it off its own
     content instead of that collapsed parent. max-width is a ceiling,
     not the binding constraint for any station today — IT EXPERT sits
     only ~119px (≈14% of the track) from WEB — NOW, which is why that
     station's label/note were kept short enough to clear it unwrapped;
     a longer label there would need this number revisited. */
  .track-label {
    position: absolute;
    left: 0;
    bottom: 43px; /* mock 26px x1.636 */
    width: max-content;
    max-width: 140px;
  }
  .track-label-name {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-md); /* 14px, mock 9px */
    font-weight: 600;
    color: var(--blue);
  }
  .track-label-name-accent {
    color: var(--green);
  }
  .track-label-sub {
    font-family: var(--font-mono);
    font-size: var(--fs-mono); /* 13px floor, mock 8px */
    color: var(--label);
  }

  /* Below 40rem, the percentage-offset stations sit too close together
     for real (F-02-floor) text — IT EXPERT and WEB — NOW are only ~14%
     apart and start colliding. Same pattern as the
     evidence-figs stack: fall back to a plain vertical list instead of
     forcing the desktop ruled-track geometry into a column too narrow
     for it. */
  @media (width < 40rem) {
    .about-track {
      height: auto;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }
    .about-track > .tick {
      display: none;
    }
    .track-station {
      position: static;
      display: flex;
      align-items: baseline;
      gap: var(--space-3);
    }
    .track-mark {
      width: 20px;
      height: 3px;
      flex: none;
    }
    .track-label {
      position: static;
    }
  }

  /* Skills / recognition row, mock gap "20px" x1.636 */
  .about-cols {
    display: flex;
    gap: 33px;
  }
  .about-col {
    flex: 1;
    min-width: 0;
  }
  @media (width < 40rem) {
    .about-cols {
      flex-direction: column;
    }
  }

  /* Mock margin-top "6px" x1.636, line-height 1.8 verbatim */
  .about-skills {
    margin-top: 10px;
    line-height: 1.8;
  }
  /* Mock margin-top "6px" x1.636 */
  .about-quote {
    margin-top: 10px;
    font-style: italic;
  }
  /* Mock margin-top "4px" x1.636 */
  .about-recognition {
    margin-top: 7px;
  }

  /* Hard action (drafting register): sharp corners, instant hover swap —
     no easing, per the radius rule (RESUME/SEND/404 never get the 4px
     software-register radius). Mock padding "10px 12px" x1.636 */
  .resume-btn {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-md);
    font-weight: 600;
    letter-spacing: var(--ls-wide);
    text-align: center;
    color: var(--white);
    background: var(--ink);
    padding: 16px 20px;
  }
  .resume-btn:hover,
  .resume-btn:focus-visible {
    background: var(--blue);
    color: var(--white);
  }

  /* Mock margin-top "5px" x1.636 */
  .resume-caption {
    font-family: var(--font-mono);
    font-size: var(--fs-mono); /* 13px floor, mock 7.5px */
    color: var(--label);
    text-align: center;
    margin-top: 8px;
  }
</style>
