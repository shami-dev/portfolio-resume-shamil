  /* Hard action (drafting register): sharp corners, instant hover swap —
     no easing, per the radius rule (RESUME/SEND/404 never get the 4px
     software-register radius). Mock padding "10px 12px" x1.636 */
  .resume-btn {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-mono-md);
    font-weight: 600;
    letter-spacing: var(--ls-wide);
    text-align: center;
    color: var(--white);
    background: var(--ink);
    padding: 16px 20px;
  }
  .resume-btn:hover,
  .resume-btn:focus-visible {
    background: var(--blue);
    color: var(--white);
  }

  /* Second RESUME.PDF instance (Phase 5b 6.4 M-P8, KPI 1 — "twice"):
     desktop keeps its single instance in the rail's bottom slot, so
     this end-of-scroll repeat — between the tick rule and the theme
     switch, matching the mock's own placement — is mobile-only. */
  .about-resume-end {
    display: none;
  }

  /* Pressed state (Phase 5b 6.0 §3) — same blue swap as :hover, since
     hover has no mobile analog to avoid doubling up with. Extended to
     tablet (Stage 3.1) — both input modes are live there. */
  @media (width < 64rem) {
    .resume-btn {
      -webkit-tap-highlight-color: transparent;
    }
    .resume-btn:active {
      background: var(--blue);
