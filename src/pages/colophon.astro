---
// Colophon (Phase 5 §5.4) — footer-tier destination, LIGHT intensity
// (.mm2, major grid lines only, same tier as About). Not a primary-nav
// item, so Nav renders with no active current per Phase 5's own mock
// (all four nrows shown inactive).
import BaseLayout from "../layouts/BaseLayout.astro";
import Rail from "../components/Rail.astro";
import Nav from "../components/Nav.astro";
import MetricCell from "../components/MetricCell.astro";
import TickRule from "../components/TickRule.astro";
import SiteFooter from "../components/SiteFooter.astro";

const title = "Colophon — how this site was built";
const description =
  "Designed in phases, each closing with a decision record — stack, type, texture, and the site's own public analytics.";
---

<BaseLayout title={title} description={description} motion>
  <Rail label="Colophon" class="rail-colophon">
    <div class="cell-pair">
      <div class="cell">
        <div class="clab">PHASES</div>
        <div class="cell-val-mono">8, logged</div>
      </div>
      <div class="cell">
        <div class="clab">ANALYTICS</div>
        <div class="cell-val-mono">public</div>
      </div>
    </div>
    <Nav slot="nav" />
    <MetricCell
      slot="extras"
      metrics={[
        { value: "100%", caption: "completion" },
        { value: "€1,000+", caption: "saved" },
        { value: "0", caption: "downtime" },
      ]}
    />
  </Rail>

  <div class="mm2 col colophon">
    <div data-register>
      <h1 class="colophon-h1">How I built this site</h1>
      <p class="prose colophon-body">
        I designed this the same way I approach client work — in phases, with a
        decision to defend at the end of each one: positioning research, content
        strategy, a reference audit, early concepts, wireframes, then desktop,
        mobile, and this tablet pass.
      </p>
    </div>

    <TickRule variant="light" />

    <div class="colophon-meta">
      <div data-register>
        <h2 class="klab">STACK</h2>
        <ul class="rail-chips colophon-stack">
          <li class="stk">Astro</li>
          <li class="stk">TypeScript</li>
          <li class="stk">Tailwind</li>
          <li class="stk">Vercel</li>
          <li class="stk">Umami</li>
        </ul>
      </div>

      <div data-register>
        <h2 class="klab">TYPE & TEXTURE</h2>
        <p class="prose colophon-note">
          Archivo + IBM Plex Mono · millimetre-paper grid · tick-rule dividers
          after the drafting scales I started my career behind.
        </p>
      </div>
    </div>

    <SiteFooter data-register />
  </div>
</BaseLayout>

<style>
  /* Mock padding "26px 30px", gap "11px" x1.636 (Phase 7 scale factor) */
  .colophon {
    gap: 18px;
    padding: 43px var(--col-pad);
  }

  /* Two genuine tablet decisions on the page that changes least of the
     eleven (spec §8.6): STACK and TYPE & TEXTURE sit side by side —
     desktop stacks them in a narrower column, mobile stacks them by
     necessity. display: contents outside this range so .colophon-meta's
     children keep landing on .colophon's own gap rhythm as plain
     siblings, same as before this wrapper existed. */
  .colophon-meta {
    display: contents;
  }
  @media (48rem <= width < 64rem) {
    .colophon-meta {
      display: flex;
      gap: 24px;
    }
    .colophon-meta > div {
      flex: 1;
    }
  }

  /* Same fix as Contact (global.css) and this page's own mobile block
     below: .col.colophon already fills .sheet's min-height: 100vh at
     these widths (verified via getBoundingClientRect — colBottom
     reaches the viewport bottom), but .site-footer itself doesn't
     reach that far when the page's content is short — true at desktop
     too, not just tablet (the width this rule originally shipped
     scoped to). No fixed bottom nav to clear at either width (that's
     mobile-only), so this needs only the margin, not the mobile
     block's extra padding-bottom reservation too. */
  @media (width >= 48rem) {
    .colophon > .site-footer {
      margin-top: auto;
    }
  }

  @media (width < 48rem) {
    .colophon {
      gap: var(--space-3);
      padding: var(--space-4) var(--col-pad);
      /* Colophon is short enough that its content often doesn't reach
         the fold, leaving the footer stranded mid-page above a blank
         gap. .col's own flex:1 already grows it to fill .sheet's
         min-height: 100vh (the mobile band's flex-direction: column
         makes that the main axis) — margin-top: auto on the footer
         (below) pushes it to the bottom of that space. body's own
         padding-bottom reserves the fixed nav's height so the page can
         scroll past it, but that's after .sheet ends — it does nothing
         for what's inside .sheet at rest, so without this the pushed
         footer lands exactly in the nav's fixed overlay zone at
         scrollY 0 (confirmed empirically: footer bottom 796 vs nav top
         756, a 40px overlap). Adding the same nav-height reservation
         here, inside .colophon's own padding, stops the flex content
         area that much short of .sheet's edge, so the auto-margined
         footer clears the nav instead of hiding behind it. */
      padding-bottom: calc(var(--space-4) + env(safe-area-inset-bottom));
    }
    .colophon > .site-footer {
      margin-top: auto;
    }
  }

  /* Mock font-size 20px x1.636, between .dcard-title's 21px (13px mock)
     and the case pages'/About's --fs-h1-case 36px (22px mock) */
  .colophon-h1 {
    font: 700 2.0625rem/1.15 var(--font-sans); /* 33px */
    letter-spacing: var(--ls-tight);
    color: var(--ink);
  }

  /* Mock: no explicit margin-top stated between heading and body in this
     block — both sit in the outer .colophon gap already */
  .colophon-body {
    margin-top: 13px; /* mock implicit ~8px x1.636, matches About's rhythm */
  }
  /* τR stays 1.00 at tablet by bounding measure instead of shrinking
     type (spec §8.1's --tb-prose-cap). */
  @media (48rem <= width < 64rem) {
    .colophon-body {
      max-width: var(--prose-cap);
    }
  }

  .colophon-stack {
    margin-top: 10px; /* mock margin-top "6px" x1.636 */
  }

  /* Mock font-size 11px, margin-top "4px" x1.636 */
  .colophon-note {
    font-size: var(--fs-body);
    margin-top: 7px;
  }
</style>
