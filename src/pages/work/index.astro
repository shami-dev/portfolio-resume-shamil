---
// Work index (Phase 5 §5.2) — HIGH intensity: unlike Home's fading grid,
// the full .mm grid runs the whole column (same pattern as the case
// pages). Five ranked records generated from the cases collection
// (rather than hand-listed) so this page can't drift out of sync with
// the case pages themselves — order is the single canonical array
// below, not duplicated content.
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Rail from "../../components/Rail.astro";
import Nav from "../../components/Nav.astro";
import MetricCell from "../../components/MetricCell.astro";
import TickRule from "../../components/TickRule.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const order = [
  "maltalink",
  "mystore",
  "ai-projects",
  "campaign-site",
  "foltirana",
] as const;

const records = await Promise.all(
  order.map(async (id) => {
    const entry = await getEntry("cases", id);
    if (!entry)
      throw new Error(`Missing content collection entry: cases/${id}`);
    return entry;
  }),
);

const title = "Decision Log — 5 records, ranked · Shamil Khaibullov";
const description =
  "Five web projects as decision records, ranked by weight of evidence — each opens to problem → decision → evidence → result.";
---

<BaseLayout title={title} description={description} motion>
  <Rail label="Shamil's work" labelRight="5 projects" class="rail-work">
    <div class="cell">
      <div class="clab">RECORDS</div>
      <div class="cell-val-mono">5, ranked</div>
    </div>
    <div class="cell-pair">
      <div class="cell">
        <div class="clab">LOC</div>
        <div class="cell-val-mono">Porto, PT</div>
      </div>
      <div class="cell">
        <div class="clab">AUTH</div>
        <div class="cell-val-mono">EU permit</div>
      </div>
    </div>
    <Nav current="work" slot="nav" />
    <MetricCell
      slot="extras"
      metrics={[
        { value: "100%", caption: "completion" },
        { value: "€1,000+", caption: "saved" },
        { value: "0", caption: "downtime" },
      ]}
    />
  </Rail>

  <div class="mm col index">
    <h1 class="h1-case" data-register>Decision log</h1>
    <p class="index-caption" data-register>
      5 RECORDS, RANKED BY WEIGHT OF EVIDENCE ·<br />
      EACH OPENS TO PROBLEM → DECISION → EVIDENCE → RESULT
    </p>

    <TickRule data-register />

    <ol class="index-list">
      {
        records.map((entry, i) => (
          <li>
            <a
              href={`/work/${entry.id}`}
              class="dcard is-hoverable work-row"
              data-register
              data-astro-prefetch="viewport"
            >
              <div class="mrow">
                <div>
                  <span class="dcard-kicker">№0{i + 1}</span>
                  <span class="work-title">{entry.data.index.title}</span>
                </div>
                <span
                  class="work-metric"
                  style={
                    entry.data.index.metricAccent
                      ? "color: var(--blue-raised)"
                      : undefined
                  }
                >
                  {entry.data.index.metric}
                </span>
              </div>
              <p class="prose work-desc">{entry.data.index.summary}</p>
            </a>
          </li>
        ))
      }
    </ol>

    <SiteFooter data-register />
  </div>
</BaseLayout>

<style>
  /* Mock padding "30px 34px" x1.636 (Phase 7 scale factor), gap loosely
     covers the h1/caption/tick/list/tick/footer rhythm — same uniform-gap
     simplification the case pages already make for kicker/h1/lede. */
  .index {
    gap: 18px;
    padding: 49px var(--col-pad);
  }

  @media (48rem <= width < 64rem) {
    .index {
      gap: var(--block-gap);
      padding: 34px var(--col-pad) 40px;
    }
  }

  @media (width < 48rem) {
    .index {
      gap: var(--space-3);
      padding: var(--space-4) var(--col-pad);
    }
  }

  .index-caption {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: var(--fs-kicker); /* 15px, mock 9.5px */
    color: var(--label);
    letter-spacing: var(--ls-wide);
    /* Legibility wash over the .mm grid — same rgb(var(--paper-rgb), 0.75)
       pattern as .case-lede-metrics/.hero-body/.block-body/.lesson. */
    background: rgb(var(--paper-rgb), 0.75);
  }

  /* Mock gap "8px" x1.636 — the record rows' own tighter internal rhythm,
     distinct from .index's outer gap */
  .index-list {
    display: flex;
    flex-direction: column;
    gap: 13px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (48rem <= width < 64rem) {
    .index-list {
      gap: var(--card-gap);
    }
    a.work-row {
      padding: var(--card-pad-tight);
    }
  }

  a.work-row {
    color: inherit;
  }

  /* Mock font-size 14px x1.636, distinct from .dcard-title's 21px (13px
     mock) used on Home's larger preview cards — this index packs 5 rows
     more densely */
  .work-title {
    font: 600 1.4375rem/1.3 var(--font-sans); /* 23px */
    margin-left: 8px;
  }

  /* №01 becomes its own row instead of running inline before the title
     — margin-left was only ever there to space it from the title on
     that shared line, so it moves to margin-top once the two split. 16px
     (--fs-body) instead of .dcard-kicker's own --fs-kicker (15px), to
     land on the same floor as the rest of the mobile body text.
     width: fit-content keeps the block-level stacking (so .work-title
     still wraps below it) without stretching to the row's full width —
     block alone made anoitecer's background span edge to edge instead
     of hugging "№01" the way an inline element would. */
  @media (width < 48rem) {
    .work-row .dcard-kicker {
      display: block;
      width: fit-content;
      font-size: var(--fs-body);
    }
    .work-title {
      margin-left: 0;
      margin-top: 4px;
    }
  }

  /* Mock font-size 10px x1.636 -> --fs-mono-lg. --green-raised (not
     --green) — these rows are .dcard, a raised surface: anoitecer's
     plain --green measures 4.19:1 there, below AA (a11y gate finding). */
  .work-metric {
    font-family: var(--font-mono);
    font-size: var(--fs-mono-lg);
    color: var(--green-raised);
    font-weight: 600;
    white-space: nowrap;
  }

  /* Desktop pattern restored (spec §8.3): fixed 220px column, not
     content-sized — the widest metric on the site ("100% · €1,000 ·
     4.55/5") measures 211px at 16px mono, so a content-sized column
     would let a longer string steal width from the title and break the
     column's alignment down the list. Title flexes to whatever's left
     of the card's 648px inner row (688 − 2×18 pad − 2 border) less the
     16px .mrow gap — no explicit width needed, flex does that. */
  @media (48rem <= width < 64rem) {
    .work-metric {
      width: 220px;
      flex: none;
      text-align: right;
    }
  }

  /* M-P2: the metric drops to its own line below the title (see .mrow's
     mobile rule in global.css) — nowrap no longer needs to protect it
     from squeezing against the title in the same row, and the longest
     metric string (AI projects', "OpenAI · iterating") would overflow
     the 390px card unwrapped. */
  @media (width < 48rem) {
    .work-metric {
      display: block;
      white-space: normal;
      margin-top: 4px;
    }
  }

  /* Mock margin-top "3px" x1.636 */
  .work-desc {
    margin-top: 5px;
  }
  /* Keeps the metric column's right edge readable as a column — without
     a cap the description would run the row's full width and the
     metrics below it would stop lining up as one visual line. */
  @media (48rem <= width < 64rem) {
    .work-desc {
      max-width: var(--prose-cap);
    }
  }
  /* Same raised-surface issue as .work-metric — .prose's --ink-body
     measures 3.86:1 on this card's --card-surface in anoitecer. */
  :root[data-theme="anoitecer"] .work-desc {
    color: var(--ink);
  }
</style>
