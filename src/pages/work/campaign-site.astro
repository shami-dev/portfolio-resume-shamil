---
// Case №04 CAMPAIGN SITE (Phase 5 §5.3) — same D/E/R anatomy as
// MALTALINK. EVIDENCE breaks from the paired-figure norm: a wide
// Lighthouse plate (held back pending a fresh re-run) beside a stacked
// pair of banner figures, rather than two equal side-by-side figures.
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Rail from "../../components/Rail.astro";
import Nav from "../../components/Nav.astro";
import TickRule from "../../components/TickRule.astro";
import Placeholder from "../../components/Placeholder.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const caseEntry = await getEntry("cases", "campaign-site");
if (!caseEntry)
  throw new Error("Missing content collection entry: cases/campaign-site");
const {
  seo,
  rail,
  kicker,
  headline,
  ledeMetrics,
  hero,
  problem,
  constraint,
  decision,
  evidence,
  result,
  lesson,
  footerNav,
} = caseEntry.data;
const [lighthouse, ...banners] = evidence.figures;
---

<BaseLayout title={seo.title} description={seo.description} motion>
  <Rail label={rail.record}>
    <Fragment slot="scan">
      <div class="cell">
        <div class="clab">RECORD</div>
        <div class="cell-name">{rail.record}</div>
      </div>
      <div class="cell">
        <div class="clab">ROLE</div>
        <div class="cell-val">
          {rail.role}
        </div>
      </div>
      <div class="cell-pair">
        {
          rail.cellPair.map((cell) => (
            <div class="cell">
              <div class="clab">{cell.label}</div>
              <div
                class="cell-val-mono"
                style={cell.accent ? "color: var(--blue-raised)" : undefined}
              >
                {cell.value}
              </div>
            </div>
          ))
        }
      </div>
      <div class="rail-foot">
        <div class="clab">TOOLS</div>
        <div class="rail-chips" style="margin-top: 4px">
          {rail.tools.map((tool) => <span class="stk">{tool}</span>)}
        </div>
        {
          rail.link && (
            <a
              href={rail.link.href}
              class="rail-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              {rail.link.label}
            </a>
          )
        }
      </div>
    </Fragment>
    <Nav current="work" />
  </Rail>

  <div class="mm col case">
    <span class="kicker" data-register>{kicker}</span>
    <h1 class="h1-case" data-register>
      {headline}
    </h1>
    <p class="case-lede-metrics">
      {ledeMetrics}
    </p>

    <Placeholder
      slug={hero.slug}
      kind={hero.kind}
      class="hero-fig"
      data-register="lg"
    />

    <div class="block" data-register>
      <h2 class="eb eb-neutral">PROBLEM</h2>
      <p class="prose block-body">
        {problem}
      </p>
    </div>

    <div class="block" data-register>
      <h2 class="eb eb-neutral">CONSTRAINT</h2>
      <p class="prose block-body">
        {constraint}
      </p>
    </div>

    <div class="dcard dcard-static" data-register="lg">
      <h2 class="eb">DECISION</h2>
      <p class="prose block-note">
        {decision}
      </p>
    </div>

    <div class="evidence" data-register="lg">
      <h2 class="eb">EVIDENCE</h2>
      <div class="evidence-figs">
        <Placeholder
          slug={lighthouse.slug}
          kind={lighthouse.kind}
          class="lighthouse-fig"
          style="height: 180px"
        />
        <div class="evidence-fig-stack">
          {
            banners.map((fig) => (
              <Placeholder
                slug={fig.slug}
                kind={fig.kind}
                class="banner-fig"
                style="flex: 1"
              />
            ))
          }
        </div>
      </div>
      <p class="prose evidence-caption">
        {evidence.caption}
      </p>
    </div>

    <div class="result" data-register="lg" data-register-beat>
      <h2 class="rb">{result.label}</h2>
      {
        result.variant === "banner" && (
          <p class="result-metrics">{result.metrics}</p>
        )
      }
      <p class="prose block-note">
        {result.body}
      </p>
    </div>

    {
      lesson && (
        <div data-register>
          <TickRule
            variant="light"
            style="max-width: 196px; margin-bottom: 8px"
          />
          <h2 class="lesson-label">LESSON</h2>
          <p class="lesson">{lesson}</p>
        </div>
      )
    }

    <TickRule variant="light" />

    <div class="case-pager" data-register>
      <a href={footerNav.prev.href} class="ftl">{footerNav.prev.label}</a>
      <a href={footerNav.next.href} class="ftl">{footerNav.next.label}</a>
    </div>

    <SiteFooter data-register />
  </div>
</BaseLayout>

<style>
  /* Mock padding "28px 34px", gap "11px" x1.636 (Phase 7 scale factor) —
     1px narrower than MALTALINK's exemplar gap (12px mock -> 20px) */
  .case {
    gap: 18px;
    padding: 46px var(--col-pad);
  }

  /* Mobile collapses to the uniform inset, same as Home: mock 10px and
     7px x1.44 -> --space-4 and --space-3 on the existing scale. */
  @media (width < 48rem) {
    .case {
      gap: var(--space-3);
      padding: var(--space-4) var(--col-pad);
    }
  }

  /* DECISION/RESULT body text, mock margin-top "6px" x1.636 */
  .block-note {
    margin-top: 10px;
  }

  /* EVIDENCE caption, mock margin-top "8px" x1.636 */
  .evidence-caption {
    margin-top: 13px;
  }

  /* Lighthouse (wide) + a stacked pair of banner figures, mock gap 10px
     x1.636 -> 16px between the two banners, same 1.4 flex weight as the
     mock's wider Lighthouse plate. Stack fills the row's cross-size via
     the row's default stretch.

     Lighthouse's flex weight lives here, in CSS, rather than inline
     alongside its height: 180px — a flex-basis (what the `1.4` in
     `flex: 1.4` sets) overrides an explicit height on the main axis
     whenever both are definite values, and inline styles always beat a
     stylesheet rule regardless of specificity or !important-free media
     queries, so the mobile override below couldn't reach a `flex`
     declared inline. Confirmed empirically: it rendered at 50px, not
     180px, until flex-basis moved out here where a plain mobile-band
     rule can reach it. */
  .lighthouse-fig {
    flex: 1.4;
  }
  .evidence-fig-stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Phase 5b 6.3c: the nested stack flattens into the same vertical run
     as the Lighthouse plate — three images, one rhythm — rather than a
     sub-group inside it; the 1.4 flex weight on Lighthouse is already
     meaningless once .evidence-figs (global.css) goes column, so it's
     reset to `none`, letting its own explicit height: 180px (inline,
     unaffected by column vs row either way) govern instead. The
     banners' height came entirely from row-stretch against Lighthouse,
     which a column layout has no equivalent for — aspect-ratio replaces
     it, relaxed to ~3.2:1 per the BANNER family spec (6.0 §5) so the
     strip stays readable at full width instead of running as tall as
     the crop happens to be. */
  @media (width < 48rem) {
    .evidence-fig-stack {
      display: contents;
    }
    .banner-fig {
      aspect-ratio: 3.2 / 1;
    }
    .lighthouse-fig {
      flex: none;
    }
  }
</style>
