---
// Case №04 CAMPAIGN SITE (Phase 5 §5.3) — same D/E/R anatomy as
// MALTALINK. EVIDENCE breaks from the paired-figure norm: a wide
// Lighthouse plate (held back pending a fresh re-run) beside a stacked
// pair of banner figures, rather than two equal side-by-side figures.
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Rail from "../../components/Rail.astro";
import Nav from "../../components/Nav.astro";
import TickRule from "../../components/TickRule.astro";
import Plate from "../../components/Plate.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const caseEntry = await getEntry("cases", "campaign-site");
if (!caseEntry)
  throw new Error("Missing content collection entry: cases/campaign-site");
const {
  seo,
  rail,
  kicker,
  headline,
  ledeMetrics,
  hero,
  problem,
  constraint,
  decision,
  evidence,
  result,
  lesson,
  footerNav,
} = caseEntry.data;

// hero.src/alt and figures[].src/alt are optional in the shared schema until
// every case migrates. This case has its images, so fail loudly rather than
// silently dropping a figure.
if (!hero.src || !hero.alt)
  throw new Error("cases/campaign-site: hero image or alt text missing");
const figures = evidence.figures.map((fig) => {
  if (!fig.src || !fig.alt)
    throw new Error(
      `cases/campaign-site: figure ${fig.slug} is missing image or alt text`,
    );
  return { ...fig, src: fig.src, alt: fig.alt };
});
const [lighthouse, ...banners] = figures;
---

<BaseLayout title={seo.title} description={seo.description} motion>
  <Rail label={rail.record}>
    <div class="cell-pair">
      {
        rail.cellPair.map((cell) => (
          <div class="cell">
            <div class="clab">{cell.label}</div>
            <div
              class="cell-val-mono"
              style={cell.accent ? "color: var(--blue-raised)" : undefined}
            >
              {cell.value}
            </div>
          </div>
        ))
      }
    </div>
    <Nav current="work" slot="nav" />
    <Fragment slot="extras">
      <div class="cell rail-title-cell">
        <div class="clab">RECORD</div>
        <div class="cell-name">{rail.record}</div>
      </div>
      <div class="cell">
        <div class="clab">ROLE</div>
        <div class="cell-val">
          {rail.role}
        </div>
      </div>
      <div class="rail-foot">
        <div class="clab">TOOLS</div>
        <ul class="rail-chips" style="margin-top: 4px">
          {rail.tools.map((tool) => <li class="stk">{tool}</li>)}
        </ul>
        {
          rail.link && (
            <a
              href={rail.link.href}
              class="rail-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              {rail.link.label}
            </a>
          )
        }
      </div>
    </Fragment>
  </Rail>

  <div class="mm col case">
    <div class="case-role-tools" data-register>
      <div class="cell">
        <div class="clab">ROLE</div>
        <div class="cell-val">{rail.role}</div>
      </div>
      <div class="rail-foot">
        <div class="clab">TOOLS</div>
        <ul class="rail-chips" style="margin-top: 4px">
          {rail.tools.map((tool) => <li class="stk">{tool}</li>)}
        </ul>
        {
          rail.link && (
            <a
              href={rail.link.href}
              class="rail-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              {rail.link.label}
            </a>
          )
        }
      </div>
    </div>

    <span class="kicker" data-register>{kicker}</span>
    <h1 class="h1-case" data-register>
      {headline}
    </h1>
    <p class="case-lede-metrics">
      {ledeMetrics}
    </p>

    <Plate
      src={hero.src}
      alt={hero.alt}
      ratio="wide"
      priority
      data-register="lg"
    />

    <div class="block" data-register>
      <h2 class="eb eb-neutral">PROBLEM</h2>
      <p class="prose block-body">
        {problem}
      </p>
    </div>

    <div class="block" data-register>
      <h2 class="eb eb-neutral">CONSTRAINT</h2>
      <p class="prose block-body">
        {constraint}
      </p>
    </div>

    <div class="dcard dcard-static" data-register="lg">
      <h2 class="eb">DECISION</h2>
      <p class="prose block-note">
        {decision}
      </p>
    </div>

    <div class="evidence" data-register="lg">
      <h2 class="eb">EVIDENCE</h2>
      <div class="evidence-figs">
        <Plate
          src={lighthouse.src}
          alt={lighthouse.alt}
          fig="FIG. 01"
          ratio="wide"
          class="lighthouse-fig"
          sizes="(min-width: 48rem) 580px, 100vw"
        />
        <div class="evidence-fig-stack">
          {
            banners.map((fig, i) => (
              <Plate
                src={fig.src}
                alt={fig.alt}
                fig={`FIG. 0${i + 2}`}
                ratio="wide"
                class="banner-fig"
                sizes="(min-width: 48rem) 420px, 100vw"
              />
            ))
          }
        </div>
      </div>
      <p class="prose evidence-caption">
        {evidence.caption}
      </p>
    </div>

    <div class="result" data-register="lg" data-register-beat>
      <h2 class="rb">{result.label}</h2>
      {
        result.variant === "banner" && (
          <p class="result-metrics">{result.metrics}</p>
        )
      }
      <p class="prose block-note">
        {result.body}
      </p>
    </div>

    {
      lesson && (
        <div data-register>
          <TickRule
            variant="light"
            style="max-width: 196px; margin-bottom: 8px"
          />
          <h2 class="lesson-label">LESSON</h2>
          <p class="lesson">{lesson}</p>
        </div>
      )
    }

    <TickRule variant="light" />

    <div class="case-pager" data-register>
      <a href={footerNav.prev.href} class="ftl">{footerNav.prev.label}</a>
      <a href={footerNav.next.href} class="ftl">{footerNav.next.label}</a>
    </div>

    <SiteFooter data-register />
  </div>
</BaseLayout>

<style>
  /* Mock padding "28px 34px", gap "11px" x1.636 (Phase 7 scale factor) —
     1px narrower than MALTALINK's exemplar gap (12px mock -> 20px) */
  .case {
    gap: 18px;
    padding: 46px var(--col-pad);
  }

  /* Mobile collapses to the uniform inset, same as Home: mock 10px and
     7px x1.44 -> --space-4 and --space-3 on the existing scale. */
  @media (48rem <= width < 64rem) {
    .case {
      gap: var(--block-gap);
      padding: 34px var(--col-pad) 40px;
    }
  }

  @media (width < 48rem) {
    .case {
      gap: var(--space-3);
      padding: var(--space-4) var(--col-pad);
    }
  }

  /* DECISION/RESULT body text, mock margin-top "6px" x1.636 */
  .block-note {
    margin-top: 10px;
  }

  /* EVIDENCE caption, mock margin-top "8px" x1.636 */
  .evidence-caption {
    margin-top: 13px;
  }

  /* Lighthouse (wide) + a stacked pair of banner figures, mock gap 10px
     x1.636 -> 16px between the two banners, same 1.4 flex weight as the
     mock's wider Lighthouse plate. Stack fills the row's cross-size via
     the row's default stretch.

     Lighthouse's flex weight lives here, in CSS, rather than inline,
     since a flex-basis needs a plain mobile-band rule to reach it (an
     inline style always beats a stylesheet rule regardless of
     specificity or !important-free media queries).

     Lighthouse keeps Plate's default 16:9 aspect-ratio — it's the row's
     tallest/defining sibling, so its own aspect drives the row's height.
     The banners must NOT also carry an aspect-ratio at this width: Plate
     sets one on .plate-img (global.css), and an aspect-ratio competing
     against a flex-grow-derived height (from row-stretch, three levels
     down through .plate-mount and .plate-img, neither of which inherits
     a percentage height from the figure by default) is what "fills the
     row's cross-size via stretch" actually requires — so the chain gets
     an explicit height: 100% and the forced aspect-ratio is cancelled
     back to auto, letting object-fit: cover crop to whatever box height
     Lighthouse established. */
  .lighthouse-fig {
    flex: 1.4;
  }
  .evidence-fig-stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  /* .evidence-figs > * (global.css) only reaches direct children
     (lighthouse-fig, evidence-fig-stack) — the banners are grandchildren,
     so they need their own flex:1 for an even split. The original
     Placeholder markup carried this as an inline style="flex: 1"; Plate
     has no equivalent prop, so it moves here. */
  .banner-fig {
    flex: 1;
  }
  .banner-fig :global(.plate-mount),
  .banner-fig :global(picture),
  .banner-fig :global(.plate-img) {
    height: 100%;
  }
  /* <picture> has no display value in global.css (default: inline), which
     breaks percentage-height resolution for the .plate-img block nested
     inside it — block is a no-op for height without a block-level
     ancestor. */
  .banner-fig :global(picture) {
    display: block;
  }
  .banner-fig :global(.plate-img) {
    aspect-ratio: auto;
  }

  /* Phase 5b 6.3c: the nested stack flattens into the same vertical run
     as the Lighthouse plate — three images, one rhythm — rather than a
     sub-group inside it; the 1.4 flex weight on Lighthouse is already
     meaningless once .evidence-figs (global.css) goes column, so it's
     reset to `none`, letting Plate's default 16:9 aspect-ratio govern
     its height instead. The banners' height came entirely from
     row-stretch against Lighthouse, which a column layout has no
     equivalent for — aspect-ratio replaces it (reinstated on .plate-img,
     with the height: 100% chain reset back to auto so it doesn't fight
     the reinstated ratio), relaxed to ~3.2:1 per the BANNER family spec
     (6.0 §5) so the strip stays readable at full width instead of
     running as tall as the crop happens to be. */
  @media (width < 48rem) {
    .evidence-fig-stack {
      display: contents;
    }
    .banner-fig {
      height: auto;
    }
    .banner-fig :global(.plate-mount),
    .banner-fig :global(picture),
    .banner-fig :global(.plate-img) {
      height: auto;
    }
    .banner-fig :global(.plate-img) {
      aspect-ratio: 3.2 / 1;
    }
    .lighthouse-fig {
      flex: none;
    }
  }

  /* Tablet (spec §8.4a "what varies"): Lighthouse plate full width, then
     the two banners side by side at 318px in-plate, 3.2:1 — a third
     pattern, not desktop's beside-the-plate stack or mobile's flattened
     column. .evidence-figs (global.css) already sets flex: 1 on every
     figure unconditionally, which would otherwise put Lighthouse and the
     stack side by side; column resets that here, same reasoning as the
     mobile override above. Same height/aspect-ratio reset as mobile: the
     stack is a row of two independently-sized banners here, not a
     row-stretch follower of Lighthouse. */
  @media (48rem <= width < 64rem) {
    .evidence-figs {
      flex-direction: column;
    }
    .lighthouse-fig {
      flex: none;
    }
    .evidence-fig-stack {
      flex-direction: row;
    }
    .banner-fig {
      height: auto;
    }
    .banner-fig :global(.plate-mount),
    .banner-fig :global(picture),
    .banner-fig :global(.plate-img) {
      height: auto;
    }
    .banner-fig :global(.plate-img) {
      aspect-ratio: 3.2 / 1;
    }
  }
</style>
