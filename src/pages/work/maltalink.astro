---
// Case №01 MALTALINK (Phase 5 §5.3) — the vertical slice's exemplar case:
// full anatomy PROBLEM/CONSTRAINT flat on grid -> DECISION lifted card ->
// EVIDENCE blue plate -> RESULT green band -> LESSON bare pull-quote.
// Phase 6B register (motion prop): kicker/headline/hero settle at load;
// PROBLEM onward join via scroll-reveal. RESULT is the numeric outcome
// band, so it carries the one-per-page beat (data-register-beat).
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Rail from "../../components/Rail.astro";
import Nav from "../../components/Nav.astro";
import TickRule from "../../components/TickRule.astro";
import Placeholder from "../../components/Placeholder.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const caseEntry = await getEntry("cases", "maltalink");
if (!caseEntry)
  throw new Error("Missing content collection entry: cases/maltalink");
const {
  seo,
  rail,
  kicker,
  headline,
  ledeMetrics,
  hero,
  problem,
  constraint,
  decision,
  evidence,
  result,
  lesson,
  footerNav,
} = caseEntry.data;
---

<BaseLayout title={seo.title} description={seo.description} motion>
  <Rail label={rail.record}>
    <Fragment slot="scan">
      <div class="cell">
        <div class="clab">TITLE</div>
        <div class="cell-val">Full-Stack Developer · front-end-focused</div>
      </div>
      <div class="cell">
        <div class="clab">ROLE</div>
        <div class="cell-val">
          {rail.role}
        </div>
      </div>
      <div class="cell-pair">
        {
          rail.cellPair.map((cell) => (
            <div class="cell">
              <div class="clab">{cell.label}</div>
              <div
                class="cell-val-mono"
                style={cell.accent ? "color: var(--blue-raised)" : undefined}
              >
                {cell.value}
              </div>
            </div>
          ))
        }
      </div>
      <div class="rail-foot">
        <div class="clab">TOOLS</div>
        <div class="rail-chips" style="margin-top: 4px">
          {rail.tools.map((tool) => <span class="stk">{tool}</span>)}
        </div>
        {
          rail.link && (
            <a
              href={rail.link.href}
              class="rail-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              {rail.link.label}
            </a>
          )
        }
      </div>
    </Fragment>
    <Nav current="work" />
  </Rail>

  <div class="mm col case">
    <span class="kicker" data-register>{kicker}</span>
    <h1 class="h1-case exemplar" data-register>
      {headline}
    </h1>
    <p class="case-lede-metrics">
      {ledeMetrics}
    </p>

    <Placeholder
      slug={hero.slug}
      kind={hero.kind}
      class="hero-fig"
      data-register="lg"
    />

    <div class="block" data-register>
      <h2 class="eb eb-neutral">PROBLEM</h2>
      <p class="prose block-body">
        {problem}
      </p>
    </div>

    <div class="block" data-register>
      <h2 class="eb eb-neutral">CONSTRAINT</h2>
      <p class="prose block-body">
        {constraint}
      </p>
    </div>

    <div class="dcard dcard-static" data-register="lg">
      <h2 class="eb">DECISION</h2>
      <p class="prose block-note">
        {decision}
      </p>
    </div>

    <div class="evidence" data-register="lg">
      <h2 class="eb">EVIDENCE</h2>
      <div class="evidence-figs">
        {
          evidence.figures.map((fig) => (
            <Placeholder
              slug={fig.slug}
              kind={fig.kind}
              style="height: 180px"
            />
          ))
        }
      </div>
      <p class="prose evidence-caption">
        {evidence.caption}
      </p>
    </div>

    <div class="result" data-register="lg" data-register-beat>
      <h2 class="rb">{result.label}</h2>
      {
        result.variant === "banner" && (
          <p class="result-metrics">{result.metrics}</p>
        )
      }
      <p class="prose block-note">
        {result.body}
      </p>
    </div>

    <div data-register>
      <TickRule variant="light" style="max-width: 196px; margin-bottom: 8px" />
      <h2 class="lesson-label">LESSON</h2>
      <p class="lesson">{lesson}</p>
    </div>

    <TickRule variant="light" />

    <div class="case-pager" data-register>
      <a href={footerNav.prev.href} class="ftl">{footerNav.prev.label}</a>
      <a href={footerNav.next.href} class="ftl">{footerNav.next.label}</a>
    </div>

    <SiteFooter data-register />
  </div>
</BaseLayout>

<style>
  /* Mock padding "28px 34px", gap "12px" x1.636 (Phase 7 scale factor) */
  .case {
    gap: 20px;
    padding: 46px var(--col-pad);
  }

  /* Mobile collapses to the uniform inset, same as Home: mock 10px and
     7px x1.44 -> --space-4 and --space-3 on the existing scale. */
  @media (width < 48rem) {
    .case {
      gap: var(--space-3);
      padding: var(--space-4) var(--col-pad);
    }
  }

  /* MALTALINK is a deliberate one-off: mock headline is 24px vs the
     22px-mock norm baked into the shared --fs-h1-case (see tokens.css) */
  .exemplar {
    font-size: 39px; /* 24px x1.636 */
  }

  /* DECISION/RESULT body text, mock margin-top "6px" x1.636 */
  .block-note {
    margin-top: 10px;
  }

  /* EVIDENCE caption, mock margin-top "8px" x1.636 */
  .evidence-caption {
    margin-top: 13px;
  }
</style>
