---
import { Font } from "astro:assets";

import "../styles/tokens.css";
import "../styles/global.css";

interface Props {
  title: string; // <=60 chars, metric-led (Phase 7 C1)
  description: string; // <=155 chars
}

const { title, description } = Astro.props;

// Built from `site` (astro.config.mjs) rather than the request URL, so
// canonical/OG stay on the production origin no matter which host served
// the page (dev, preview, *.workers.dev).
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Mode restore, before first paint. Must stay is:inline and in <head>:
         a bundled module script is deferred, which would paint light first
         and flash. Light is the bare :root token set, so it sets nothing.
         prefers-color-scheme resolves to dark or light only — anoitecer is
         a deliberate middle and is never auto-selected, which is the
         "dimmed default" the dark-mode phase rules out.
         Needs a CSP hash once security.csp is enabled. -->
    <script is:inline>
      (function () {
        const root = document.documentElement;
        let stored = null;
        try {
          stored = localStorage.getItem("mode");
        } catch {
          /* storage blocked — fall through to the system preference */
        }
        if (stored === "dark" || stored === "anoitecer") {
          root.dataset.theme = stored;
        } else if (
          !stored &&
          window.matchMedia("(prefers-color-scheme: dark)").matches
        ) {
          root.dataset.theme = "dark";
        }
      })();
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <!-- Astro's Font API: handles fallback metrics automatically; preload
         is scoped to just the two above-the-fold weights (Phase 7 F-08) —
         verified against astro's PreloadFilter type, `preload` alone
         would otherwise preload all 11 configured weight/style files. -->
    <Font
      cssVariable="--font-archivo"
      preload={[{ weight: 700, style: "normal" }]}
    />
    <Font
      cssVariable="--font-ibm-plex-mono"
      preload={[{ weight: 600, style: "normal" }]}
    />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="sheet">
      <slot />
    </div>
  </body>
</html>
