{
  "name": "portfolio-resume-shamil",
  "compatibility_date": "2026-06-04",
  "assets": {
    // @astrojs/cloudflare nests static output under dist/client (dist/server
    // holds the worker bundle, unused while every page stays prerendered).
    "directory": "./dist/client",
    // Matches trailingSlash: "never" in astro.config.mjs: /about/ redirects
    // to /about instead of the Cloudflare default (auto-trailing-slash).
    "html_handling": "drop-trailing-slash",
  },
  // Per-IP throttle for the contact action (src/actions/index.ts). Counters
  // are per-Cloudflare-location and eventually consistent — a deterrent,
  // not an accounting system (Cloudflare's own framing).
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 3,
        "period": 60,
      },
    },
  ],
}
